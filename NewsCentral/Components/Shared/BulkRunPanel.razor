@* UI-2 — progress line (with Stop) while a bulk run is active, and the result summary once it
   finishes. Operates directly on BulkRunResult<Assignment> — all three bulk actions on this page
   set (Approve/Reject/Publish) act on Assignment items, so a generic item-label callback was not
   needed; the failure/warning lines use Assignment.TargetTeam directly. *@
@using NewsCentral.Models
@using NewsCentral.Ui

@if (Running)
{
    <div class="bulk-run-progress">
        <span>@Verb @Done of @Total…</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => OnStop.InvokeAsync())">Stop</button>
    </div>
}
else if (Result != null)
{
    var failures = Result.Outcomes.Where(o => !o.Outcome.Succeeded).ToList();
    var warnings = Result.Outcomes.Where(o => o.Outcome.Succeeded && o.Outcome.Warning != null).ToList();
    var alertClass = (failures.Count > 0 || warnings.Count > 0) ? "alert-warning" : "alert-success";

    <div class="alert @alertClass mt-2">
        <strong>@Result.SucceededCount</strong> succeeded, <strong>@failures.Count</strong> failed@(Result.Stopped ? " — stopped before all items were processed" : "").

        @if (warnings.Count > 0 && WarningSummaryFormat != null)
        {
            <div class="mt-2">@string.Format(WarningSummaryFormat, warnings.Count)</div>
            <ul class="mb-0 mt-1">
                @foreach (var w in warnings.Take(5))
                {
                    <li>@w.Item.TargetTeam: @w.Outcome.Warning?.TrimEnd('.')</li>
                }
            </ul>
        }

        @if (failures.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @foreach (var f in failures.Take(20))
                {
                    <li>@f.Item.TargetTeam: @f.Outcome.Error?.TrimEnd('.')</li>
                }
                @if (failures.Count > 20)
                {
                    <li>+@(failures.Count - 20) more</li>
                }
            </ul>
        }
    </div>
}

<style>
    .bulk-run-progress {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        font-size: 14px;
        color: #333;
    }
</style>

@code {
    [Parameter] public bool Running { get; set; }
    [Parameter] public int Done { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public string Verb { get; set; } = "Processing";
    [Parameter] public BulkRunResult<Assignment>? Result { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    /// <summary>
    /// A composite-format string with one placeholder for the warning count, e.g.
    /// "{0} assignment(s) published with distribution warnings" — Publish-only; Approve/Reject
    /// never produce a Warning outcome, so this stays null for them and the block never renders.
    /// </summary>
    [Parameter] public string? WarningSummaryFormat { get; set; }
}
