@* UI-2 — reusable master checkbox: unchecked / checked / indeterminate, driven by a
   NewsCentral.Ui.SelectionState rather than owning any selection state itself. The DOM
   `indeterminate` property has no HTML attribute equivalent, so it is set via the
   `ncSetIndeterminate` JS interop (wwwroot/js/selection.js) after every render. *@
@using NewsCentral.Ui
@inject IJSRuntime JS

<label class="tri-state-checkbox @(Disabled ? "tri-state-checkbox-disabled" : "")">
    <input type="checkbox" @ref="checkboxRef"
           checked="@(State == SelectionState.All)"
           disabled="@Disabled"
           @onchange="HandleChange" />
    @if (Label != null)
    {
        <span>@Label</span>
    }
</label>

<style>
    .tri-state-checkbox {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        font-weight: normal;
        margin-bottom: 0;
    }

    .tri-state-checkbox-disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
</style>

@code {
    [Parameter] public SelectionState State { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference checkboxRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("ncSetIndeterminate", checkboxRef, State == SelectionState.Some);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[TriStateCheckbox] Failed to set indeterminate state: {ex.Message}");
        }
    }

    private async Task HandleChange()
    {
        if (!Disabled)
            await OnToggle.InvokeAsync();
    }
}
