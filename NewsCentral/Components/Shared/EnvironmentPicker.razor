@* M4a — environment picker. M4a.1 — menu containment, row layout, tooltips, Add dialog's own
   styling. TODO(i18n): plain English for now, following MainLayout/ConfirmDialog. *@
@using NewsCentral.Configuration
@using NewsCentral.Services
@inject EnvironmentDirectoryService EnvironmentDirectory
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="env-picker">
    @if (isLocked)
    {
        <span class="env-picker-locked" title="@LockedTooltip">
            <i class="bi bi-hdd-network me-1"></i>@current?.DisplayName
        </span>
    }
    else
    {
        <div class="env-picker-dropdown">
            <button class="btn btn-sm btn-outline-secondary env-picker-toggle" @onclick="ToggleOpen"
                    title="@ToggleTooltip" aria-expanded="@AriaExpanded">
                <i class="bi bi-hdd-network me-1"></i>
                <span class="env-picker-toggle-name">@current?.DisplayName</span>
                <i class="bi bi-chevron-down ms-1"></i>
            </button>

            @if (isOpen)
            {
                @* Transparent full-window backdrop, below the menu — closes the menu on an outside
                   click without needing to stopPropagation inside the menu itself (the menu paints
                   on top, so a click inside it never reaches the backdrop). *@
                <div class="env-picker-backdrop" @onclick="CloseMenu"></div>

                <div class="env-picker-menu" tabindex="-1" @ref="menuElement" @onkeydown="HandleMenuKeyDown">
                    @foreach (var option in options)
                    {
                        var showBadges = option.Kind == EnvironmentKind.Policy
                            || option.Kind == EnvironmentKind.Shared
                            || !option.IsShareable;
                        var canHide = (option.Kind == EnvironmentKind.Policy || option.Kind == EnvironmentKind.Shared) && isAuthenticated;
                        var canRemove = (option.Kind == EnvironmentKind.User || option.Kind == EnvironmentKind.Shared) && isSystemAdmin;

                        <div class="env-picker-row @(option.IsCurrent ? "env-picker-row-current" : "")">
                            <div class="env-picker-row-main" @onclick="() => RequestSwitch(option)">
                                <span class="env-picker-check">@(option.IsCurrent ? "✓" : "")</span>
                                <div class="env-picker-row-body">
                                    <div class="env-picker-row-name">@option.DisplayName</div>
                                    <div class="env-picker-row-path" title="@option.DataPath">@option.DataPath</div>
                                    @if (showBadges)
                                    {
                                        <div class="env-picker-row-badges">
                                            @if (option.Kind == EnvironmentKind.Policy)
                                            {
                                                <span class="badge bg-secondary env-picker-badge">policy</span>
                                            }
                                            @if (option.Kind == EnvironmentKind.Shared)
                                            {
                                                <span class="badge bg-info text-dark env-picker-badge">shared</span>
                                            }
                                            @if (!option.IsShareable)
                                            {
                                                <span class="badge bg-light text-dark env-picker-badge">this computer only</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="env-picker-row-actions">
                                @if (canHide)
                                {
                                    <button class="btn btn-sm btn-link env-picker-action" @onclick="() => Hide(option)">Hide</button>
                                }
                                @if (canRemove)
                                {
                                    @if (option.IsCurrent)
                                    {
                                        <span class="d-inline-block" title="Cannot remove the current environment." tabindex="0">
                                            <button class="btn btn-sm btn-link text-danger env-picker-action" disabled
                                                     style="pointer-events:none">
                                                Remove
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-link text-danger env-picker-action" title="Remove"
                                                 @onclick="() => RequestRemove(option)">
                                            Remove
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <div class="env-picker-footer">
                        @if (canAdd)
                        {
                            <button class="btn btn-sm btn-link" @onclick="OpenAddDialog">Add environment…</button>
                        }
                        @if (hiddenCount > 0)
                        {
                            <button class="btn btn-sm btn-link" @onclick="ShowHidden">Show hidden (@hiddenCount)</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* M4b.1: .top-row's inherited white-space:nowrap reaches straight through this component
   boundary into ConfirmDialog's own rendered markup — wrapping each usage in an element that
   resets white-space back to normal is the fix, without touching ConfirmDialog.razor itself. *@
<div class="env-picker-dialog-wrap">
    <ConfirmDialog IsVisible="showSwitchConfirm"
                   Title="Switch environment?"
                   Message="@($"Switch to {pendingSwitchName}? You will be signed out; unsaved changes will be lost.")"
                   ConfirmText="Switch"
                   CancelText="Cancel"
                   DialogType="warning"
                   OnConfirm="DoSwitch"
                   OnCancel="CancelSwitch" />
</div>

<div class="env-picker-dialog-wrap">
    <ConfirmDialog IsVisible="showRemoveConfirm"
                   Title="Remove shared environment?"
                   Message="@($"Remove {pendingRemoveOption?.DisplayName} for everyone? It will disappear from every environment's directory as they synchronize.")"
                   ConfirmText="Remove"
                   CancelText="Cancel"
                   DialogType="danger"
                   OnConfirm="ConfirmRemove"
                   OnCancel="CancelRemove" />
</div>

@if (showAddDialog)
{
    <div class="env-picker-add-overlay" @onclick="CloseAddDialogIfIdle">
        <div class="env-picker-add-panel" @onclick:stopPropagation="true">
            <h5 class="env-picker-add-title">Add environment</h5>

            @if (addNotInitializedNote != null)
            {
                <p class="env-picker-note">@addNotInitializedNote</p>
                <div class="env-picker-add-actions">
                    <button class="btn btn-primary" @onclick="CloseAddDialog">OK</button>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">Path</label>
                    <input type="text" class="form-control" @bind="addPath" @bind:event="oninput" disabled="@isProbing"
                           placeholder="\\server\share\newscentral or C:\NewsCentral" />
                </div>
                @if (AddPathIsUnc)
                {
                    <div class="alert alert-info env-picker-unc-note">
                        This environment will be added to the shared directory and become visible to other operators.
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Display name (optional)</label>
                    <input type="text" class="form-control" @bind="addDisplayName" disabled="@isProbing" />
                </div>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="alert alert-danger">@addError</div>
                }

                <div class="env-picker-add-actions">
                    <button class="btn btn-secondary" @onclick="CloseAddDialog" disabled="@isProbing">Cancel</button>
                    <button class="btn btn-primary" @onclick="SubmitAdd" disabled="@isProbing">
                        @(isProbing ? "Checking…" : "Add")
                    </button>
                </div>
            }
        </div>
    </div>
}

<style>
    .env-picker {
        position: relative;
        display: inline-block;
        /* .top-row is a flex container; a flex item's default min-width:auto uses its content's
           unwrapped intrinsic width (white-space:nowrap makes that the FULL text width), which
           defeats any inner max-width/ellipsis and can force the row wider than the window. No
           overflow:hidden here — the dropdown menu is an absolutely-positioned descendant that
           intentionally extends well beyond this element's own box, and clipping would hide it. */
        min-width: 0;
        /* M5a: at every width, not just narrow ones — the toggle's own border otherwise touches
           the user icon directly next to it. */
        margin-right: 0.75rem;
    }

    /* M4b.1: resets .top-row's inherited white-space:nowrap for both ConfirmDialog usages below,
       without touching ConfirmDialog.razor itself. */
    .env-picker-dialog-wrap {
        white-space: normal;
    }

        .env-picker-dialog-wrap .confirm-dialog p {
            overflow-wrap: anywhere;
        }

    .env-picker-locked {
        color: #6c757d;
        font-size: 0.875rem; /* matches .btn-sm's font-size, for consistency with the dropdown toggle */
        margin-right: 0.5rem;
    }

    .env-picker-dropdown { position: relative; }

    .env-picker-toggle {
        /* M4a.2: .btn-outline-secondary's border-color:#6c757d computed correctly against .btn's
           base border, but was hard to see against the top-row's near-white background — an
           explicit, slightly higher-contrast border here removes any doubt. Radius already comes
           from .btn-sm, not redeclared. */
        border: 1px solid #adb5bd;
    }

    .env-picker-toggle:hover {
        border-color: #6c757d;
    }

    .env-picker-toggle-name {
        display: inline-block;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }

    /* M4b.1: below 641px there is no sidebar, so the header has less room overall — shrink the
       toggle name's budget too, matching the mobile treatment MainLayout.razor.css applies to the
       user's own display name. */
    @@media (max-width: 640.98px) {
        .env-picker-toggle-name {
            max-width: 120px;
        }
    }

    .env-picker-backdrop {
        position: fixed;
        inset: 0;
        background: transparent;
        z-index: 1499;
    }

    .env-picker-menu {
        position: absolute;
        top: 100%;
        right: 0;
        left: auto;
        margin-top: 4px;
        /* No sidebar below 641px (NavMenu collapses behind its hamburger toggle) — the full
           viewport width (minus a margin) is available. */
        width: min(460px, calc(100vw - 2rem));
        max-height: calc(100vh - 5rem);
        overflow-y: auto;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        z-index: 1500;
        padding: 6px 0;
    }

    /* Matches MainLayout.razor.css's own min-width:641px breakpoint, where the sidebar becomes a
       fixed 250px column — the menu is right-anchored inside the content area, which starts at
       x=250px, so its available width must subtract the sidebar or it overflows past the
       window's left edge. */
    @@media (min-width: 641px) {
        .env-picker-menu {
            width: min(460px, calc(100vw - 250px - 2rem));
        }
    }

    /* M5a: below 641px (no sidebar, header collapsed to the hamburger toggle) the menu is anchored
       to the viewport instead of the toggle button — right:0 (relative to .env-picker-dropdown)
       could still push the menu past the window's left edge at some in-between widths depending on
       where the toggle itself sits; fixed positioning with symmetric margins guarantees it never
       does. top:3.5rem matches .top-row's own height in MainLayout.razor.css. */
    @@media (max-width: 640.98px) {
        .env-picker-menu {
            position: fixed;
            left: 1rem;
            right: 1rem;
            top: 3.5rem;
            width: auto;
        }
    }

    .env-picker-row {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        gap: 8px;
    }

    .env-picker-row:hover { background: #f8f9fa; }

    .env-picker-row-current { background: #eef3ff; }

    .env-picker-row-main {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        flex: 1;
        cursor: pointer;
        min-width: 0;
    }

    .env-picker-check {
        width: 1em;
        flex-shrink: 0;
        margin-top: 1px;
        color: #0d6efd;
        font-weight: bold;
    }

    .env-picker-row-body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
    }

    .env-picker-row-name {
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .env-picker-row-path {
        font-size: 11px;
        color: #6c757d;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .env-picker-row-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 2px;
    }

    .env-picker-badge { font-size: 10px; }

    .env-picker-row-actions {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .env-picker-action { white-space: nowrap; padding: 0 4px; }

    .env-picker-footer {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid #eee;
        margin-top: 4px;
        padding: 6px 12px 0;
    }

    .env-picker-add-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        /* M4b.1: resets the inherited white-space:nowrap from .top-row (see the dialog-wrap
           comment above) — the Add dialog lives in the same component tree, not inside a wrapper. */
        white-space: normal;
    }

    .env-picker-add-panel {
        background: #fff;
        border-radius: 8px;
        padding: 24px;
        width: min(520px, calc(100vw - 2rem));
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        text-align: left;
        white-space: normal;
        /* Inherited, so it reaches every descendant's text (the title, the note, the error alert)
           without needing a rule per element — breaks an unbroken UNC path instead of overflowing. */
        overflow-wrap: anywhere;
    }

    .env-picker-add-title { margin: 0 0 15px 0; }

    .env-picker-add-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .env-picker-note { color: #333; }

    .env-picker-unc-note { font-size: 13px; padding: 8px 12px; margin-bottom: 1rem; }
</style>

@code {
    private IReadOnlyList<EnvironmentOption> options = Array.Empty<EnvironmentOption>();
    private EnvironmentOption? current;
    private bool isLocked;
    private bool canAdd;
    private int hiddenCount;
    private bool isAuthenticated;
    private bool isSystemAdmin;
    private bool isOpen;
    private bool shouldFocusMenu;
    private ElementReference menuElement;

    private bool showSwitchConfirm;
    private string? pendingSwitchPath;
    private string? pendingSwitchName;

    private bool showRemoveConfirm;
    private EnvironmentOption? pendingRemoveOption;

    private bool showAddDialog;
    private string addPath = string.Empty;
    private string addDisplayName = string.Empty;
    private bool isProbing;
    private string? addError;
    private string? addNotInitializedNote;

    private bool AddPathIsUnc => EnvironmentPaths.IsShareable(addPath);

    private string LockedTooltip => "No other environments are configured.";
    private string ToggleTooltip => $"Environment: {current?.DisplayName} — {current?.DataPath}";
    private string AriaExpanded => isOpen ? "true" : "false";

    protected override void OnInitialized()
    {
        EnvironmentDirectory.Changed += HandleChanged;
        AuthService.OnAuthenticationStateChanged += HandleChanged;
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusMenu)
        {
            shouldFocusMenu = false;
            try
            {
                // Gives the menu keyboard focus so Escape (HandleMenuKeyDown) can close it. Uses
                // Blazor's own built-in ElementReference.FocusAsync() helper — no hand-written JS
                // interop file. A race with the menu closing again before render completes is
                // harmless: FocusAsync on a detached element just no-ops/throws, caught below.
                await menuElement.FocusAsync();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[EnvironmentPicker] FocusAsync failed: {ex.Message}");
            }
        }
    }

    private void Refresh()
    {
        isAuthenticated = AuthService.IsAuthenticated();
        isSystemAdmin = AuthService.IsSystemAdmin();
        options = EnvironmentDirectory.GetOptions(includeHidden: false);
        current = EnvironmentDirectory.Current;
        canAdd = EnvironmentDirectory.CanAdd;
        isLocked = EnvironmentDirectory.IsLocked;

        var fullOptions = EnvironmentDirectory.GetOptions(includeHidden: true);
        hiddenCount = fullOptions.Count(o => o.IsHidden) - options.Count(o => o.IsHidden);
    }

    private void HandleChanged()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    private void ToggleOpen()
    {
        isOpen = !isOpen;
        shouldFocusMenu = isOpen;
    }

    private void CloseMenu() => isOpen = false;

    private void HandleMenuKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseMenu();
    }

    private void RequestSwitch(EnvironmentOption option)
    {
        isOpen = false;

        if (option.IsCurrent)
            return;

        pendingSwitchPath = option.DataPath;
        pendingSwitchName = option.DisplayName;

        if (isAuthenticated)
            showSwitchConfirm = true;
        else
            DoSwitch();
    }

    private void DoSwitch()
    {
        showSwitchConfirm = false;
        if (pendingSwitchPath == null)
            return;

        EnvironmentDirectory.SwitchTo(pendingSwitchPath);
        pendingSwitchPath = null;
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void CancelSwitch()
    {
        showSwitchConfirm = false;
        pendingSwitchPath = null;
    }

    private async Task Hide(EnvironmentOption option)
    {
        await EnvironmentDirectory.HideAsync(option.DataPath);
        isOpen = false;
    }

    private void RequestRemove(EnvironmentOption option)
    {
        isOpen = false;

        if (option.Kind == EnvironmentKind.Shared)
        {
            // Shared removal is a tombstone that propagates to every environment that syncs it, so
            // it gets an explicit confirmation — unlike a plain User entry, which only ever affects
            // this machine and is removed immediately below.
            pendingRemoveOption = option;
            showRemoveConfirm = true;
        }
        else
        {
            _ = Remove(option);
        }
    }

    private async Task ConfirmRemove()
    {
        showRemoveConfirm = false;
        if (pendingRemoveOption == null)
            return;

        await Remove(pendingRemoveOption);
        pendingRemoveOption = null;
    }

    private void CancelRemove()
    {
        showRemoveConfirm = false;
        pendingRemoveOption = null;
    }

    private async Task Remove(EnvironmentOption option)
    {
        if (option.IsCurrent)
            return;

        await EnvironmentDirectory.RemoveAsync(option.DataPath);
    }

    private async Task ShowHidden()
    {
        await EnvironmentDirectory.UnhideAllAsync();
        isOpen = false;
    }

    private void OpenAddDialog()
    {
        addPath = string.Empty;
        addDisplayName = string.Empty;
        addError = null;
        addNotInitializedNote = null;
        showAddDialog = true;
        isOpen = false;
    }

    private void CloseAddDialog()
    {
        showAddDialog = false;
        addNotInitializedNote = null;
    }

    // The overlay's own click-to-dismiss must not fire while a probe is in flight or while the
    // not-initialized note is waiting for its explicit OK click.
    private void CloseAddDialogIfIdle()
    {
        if (!isProbing && addNotInitializedNote == null)
            CloseAddDialog();
    }

    private async Task SubmitAdd()
    {
        addError = null;
        isProbing = true;
        try
        {
            var result = await EnvironmentDirectory.AddAsync(addPath, addDisplayName);

            switch (result.Outcome)
            {
                case AddOutcome.Added:
                    showAddDialog = false;
                    break;
                case AddOutcome.AddedNotInitialized:
                    addNotInitializedNote =
                        "This environment is not initialized. An administrator will be able to initialize it from Environment Management.";
                    break;
                default:
                    addError = result.ErrorMessage ?? "Could not add that environment.";
                    break;
            }
        }
        finally
        {
            isProbing = false;
        }
    }

    public void Dispose()
    {
        EnvironmentDirectory.Changed -= HandleChanged;
        AuthService.OnAuthenticationStateChanged -= HandleChanged;
    }
}
