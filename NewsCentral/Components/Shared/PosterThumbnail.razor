@* UI-2.1/UI-2.2 — reusable poster thumbnail with a click-to-enlarge lightbox. The small image is
   always the cheap, cached thumbnail (ThumbnailDataUrl); the full-size image is produced only on
   demand, via GetFullImageDataUrl, and kept only while the lightbox is open — a render batch never
   carries a full-size image for a thumbnail nobody is looking at. With no thumbnail, renders a
   neutral, non-clickable "No preview" placeholder of the same footprint instead of nothing, so a
   row of thumbnails stays visually aligned. Styles live in PosterThumbnail.razor.css (scoped) —
   NOT an inline <style> block — so they ship once in the bundled stylesheet instead of once per
   rendered instance. *@

@if (!string.IsNullOrEmpty(ThumbnailDataUrl))
{
    <img class="poster-thumbnail" src="@ThumbnailDataUrl" alt="@Title" title="Click to enlarge"
         style="width: @(Width)px;" @onclick="Open" />
}
else
{
    <div class="poster-thumbnail poster-thumbnail-placeholder" style="width: @(Width)px;">
        No preview
    </div>
}

@if (isOpen)
{
    <div class="poster-lightbox-overlay" tabindex="-1" @ref="overlayRef" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="poster-lightbox-content" @onclick:stopPropagation="true">
            <button type="button" class="poster-lightbox-close" @onclick="Close" aria-label="Close">×</button>
            <img src="@lightboxImageDataUrl" alt="@Title" class="poster-lightbox-image" />
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="poster-lightbox-title">@Title</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? ThumbnailDataUrl { get; set; }
    [Parameter] public Func<string?>? GetFullImageDataUrl { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public int Width { get; set; } = 120;

    private bool isOpen;
    private bool wasOpen;
    private string? lightboxImageDataUrl;
    private ElementReference overlayRef;

    private void Open()
    {
        if (string.IsNullOrEmpty(ThumbnailDataUrl))
            return;

        // The full image lives only in this field, and only while the lightbox is open. If the
        // caller has no full image to offer (or it returns null), the thumbnail itself is shown
        // enlarged rather than nothing.
        lightboxImageDataUrl = GetFullImageDataUrl?.Invoke() ?? ThumbnailDataUrl;
        isOpen = true;
    }

    private void Close()
    {
        isOpen = false;
        lightboxImageDataUrl = null;
    }

    // No form inside the lightbox, so closing on an outside click (via the overlay's own @onclick,
    // above) or Escape is always safe here.
    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isOpen && !wasOpen)
        {
            try
            {
                await overlayRef.FocusAsync();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[PosterThumbnail] Failed to focus the lightbox: {ex.Message}");
            }
        }

        wasOpen = isOpen;
    }
}
