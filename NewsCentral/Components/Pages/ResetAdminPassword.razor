@page "/reset-admin"
@inject Services.UserService UserService

<h1>Reset Admin Password</h1>

<button @onclick="ResetPassword">Reset Admin to 'admin123'</button>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private string message = string.Empty;
    private string errorMessage = string.Empty;

    private async Task ResetPassword()
    {
        message = string.Empty;
        errorMessage = string.Empty;

        try
        {
            var success = await UserService.ResetAdminPasswordAsync("admin123");
            
            if (success)
            {
                message = "Admin password has been reset to 'admin123'. You can now login with: admin / admin123";
            }
            else
            {
                errorMessage = "Failed to reset password - admin user not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}
