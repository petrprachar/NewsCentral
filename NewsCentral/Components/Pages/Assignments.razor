@code {
    private List<Assignment> assignments = new();
    private List<Presentation> presentations = new();
    private List<Schedule> schedules = new();

    private static string? PresentationThumb(Presentation? p)
    {
        if (p is null || string.IsNullOrEmpty(p.ContentImageBase64)) return null;
        var ext = System.IO.Path.GetExtension(p.ImageName ?? p.ImageOriginalName ?? "").ToLowerInvariant();
        var mime = ext switch
        {
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            _ => "image/jpeg"
        };
        return $"data:{mime};base64,{p.ContentImageBase64}";
    }

    private List<Assignment> pendingAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.PendingApproval)
        .OrderByDescending(a => a.DateCreated)
        .ToList();

    private List<Assignment> approvedAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.Approved)
        .OrderByDescending(a => a.ApprovedDate ?? a.DateCreated)
        .ToList();

    private List<Assignment> publishedAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.Published)
        .OrderByDescending(a => a.PublishedDate ?? a.DateCreated)
        .ToList();

    private bool isLoading = true;
    private bool isPublishing = false;
    private bool isDeleting = false;
    private string? publishingAssignmentId;
    private string? deletingAssignmentId;
    private string? errorMessage;
    private string? successMessage;
    private User? currentUser;
    private string? currentTeamFolder;

    protected override async Task OnInitializedAsync()
    {
        currentUser = AuthService.GetCurrentUser();
        currentTeamFolder = TeamContext.CurrentTeamFolderName;

        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (string.IsNullOrEmpty(currentTeamFolder))
        {
            errorMessage = "No team selected. Please select a team from the home page.";
            isLoading = false;
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Load ALL assignments for the current team (not just user's own)
            assignments = await AssignmentService.GetAssignmentsForTeamAsync(currentTeamFolder!);

            // Load presentations and schedules
            presentations = await PresentationService.GetPresentationsForTeamAsync(currentTeamFolder!);
            schedules = await ScheduleService.GetSchedulesForTeamAsync(currentTeamFolder!);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Error loading assignments: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }
    /*
    private bool CanEdit(Assignment assignment)
    {
        if (currentUser == null) return false;

        // SystemAdmin can edit anything
        if (currentUser.IsSystemAdmin) return true;

        // Creator can edit their own (if not published)
        if (assignment.CreatedBy == currentUser.UserID &&
            assignment.Status != AssignmentStatus.Published)
            return true;

        return false;
    }
    */
    private bool CanDelete(Assignment assignment)
    {
        if (currentUser == null) return false;

        // For Pending/Approved: Any ContentAuthor from current team OR SystemAdmin
        if (assignment.Status != AssignmentStatus.Published)
        {
            // SystemAdmin can delete anything
            if (currentUser.IsSystemAdmin) return true;

            // Any ContentAuthor from current team can delete
            var hasContentAuthorRole = currentUser.TeamRoles.Any(tr =>
                tr.TeamFolderName == currentTeamFolder &&
                tr.Roles.Contains("ContentAuthor"));

            if (hasContentAuthorRole) return true;
        }

        return false;
    }
    
    /*
    private bool CanDelete(Assignment assignment)
    {
        if (currentUser == null) return false;

        // SystemAdmin can delete anything
        if (currentUser.IsSystemAdmin) return true;

        // Any ContentAuthor from current team can delete (Pending/Approved/Published)
        var hasContentAuthorRole = currentUser.TeamRoles.Any(tr =>
            tr.TeamFolderName == currentTeamFolder &&
            tr.Roles.Contains("ContentAuthor"));

        return hasContentAuthorRole;
    }
    */

    private bool CanDeletePublished(Assignment assignment)
    {
        if (currentUser == null) return false;

        // SystemAdmin can delete any published assignment
        if (currentUser.IsSystemAdmin) return true;

        // Any ContentAuthor from current team can delete published assignments
        var hasContentAuthorRole = currentUser.TeamRoles.Any(tr =>
            tr.TeamFolderName == currentTeamFolder &&
            tr.Roles.Contains("ContentAuthor"));

        return hasContentAuthorRole;
    }

    /*
    private bool CanPublish(Assignment assignment)
    {
        if (currentUser == null) return false;

        // Only approved assignments can be published
        if (assignment.Status != AssignmentStatus.Approved) return false;

        // SystemAdmin can publish
        if (currentUser.IsSystemAdmin) return true;

        // Creator can publish their own
        if (assignment.CreatedBy == currentUser.UserID) return true;

        return false;
    }
    */

    private bool CanPublish(Assignment assignment)
    {
        if (currentUser == null) return false;

        // Only approved assignments can be published
        if (assignment.Status != AssignmentStatus.Approved) return false;

        // SystemAdmin can publish anything
        if (currentUser.IsSystemAdmin) return true;

        // Creator can publish their own
        if (assignment.CreatedBy == currentUser.UserID) return true;

        // Any ContentAuthor of the current team can publish
        // regardless of who created the assignment
        var teamFolderName = TeamContext.GetCurrentTeamFolderName();
        return currentUser.TeamRoles.Any(tr =>
            tr.TeamFolderName == teamFolderName &&
            tr.Roles.Contains("ContentAuthor"));
    }
    /*
    private void EditAssignment(Assignment assignment)
    {
        Navigation.NavigateTo($"/edit-assignment/{assignment.SourceTeam}/{assignment.AssignmentID}");
    }
    */
    private async Task DeleteAssignment(Assignment assignment)
    {
        try
        {
            isDeleting = true;
            deletingAssignmentId = assignment.AssignmentID;
            errorMessage = null;
            successMessage = null;

            await AssignmentService.DeleteAssignmentAsync(assignment.SourceTeam, assignment.AssignmentID);

            successMessage = "Assignment moved to deleted folder";
            await LoadDataAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "You don't have permission to delete this assignment";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting assignment: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Delete error: {ex}");
        }
        finally
        {
            isDeleting = false;
            deletingAssignmentId = null;
        }
    }

    private async Task PublishAssignment(Assignment assignment)
    {
        try
        {
            isPublishing = true;
            publishingAssignmentId = assignment.AssignmentID;
            errorMessage = null;
            successMessage = null;

            var result = await PublishingService.PublishAssignmentAsync(
                assignment.SourceTeam,
                assignment.AssignmentID);

            if (result.Success)
            {
                successMessage = result.Message;
                await LoadDataAsync();
            }
            else
            {
                errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error publishing: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Publish error: {ex}");
        }
        finally
        {
            isPublishing = false;
            publishingAssignmentId = null;
        }
    }

    private string GetDaysOfWeekString(string daysOfWeek)
    {
        if (string.IsNullOrEmpty(daysOfWeek)) return "All days";

        var dayMap = new Dictionary<string, string>
        {
            {"1", "Mon"}, {"2", "Tue"}, {"3", "Wed"},
            {"4", "Thu"}, {"5", "Fri"}, {"6", "Sat"}, {"7", "Sun"}
        };

        var days = daysOfWeek.Split(',')
            .Select(d => dayMap.ContainsKey(d.Trim()) ? dayMap[d.Trim()] : d.Trim());

        return string.Join(", ", days);
    }
}