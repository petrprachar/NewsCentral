@code {
    private List<Assignment> assignments = new();
    private List<Presentation> presentations = new();
    private List<Schedule> schedules = new();

    private List<Assignment> pendingAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.PendingApproval)
        .OrderByDescending(a => a.DateCreated)
        .ToList();

    private List<Assignment> approvedAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.Approved)
        .OrderByDescending(a => a.ApprovedDate ?? a.DateCreated)
        .ToList();

    private List<Assignment> publishedAssignments => assignments
        .Where(a => a.Status == AssignmentStatus.Published)
        .OrderByDescending(a => a.PublishedDate ?? a.DateCreated)
        .ToList();

    private bool isLoading = true;
    private bool isPublishing = false;
    private string? publishingAssignmentId;
    private string? errorMessage;
    private string? successMessage;
    private string? warningMessage;
    private User? currentUser;
    private string? currentTeamFolder;

    // UI-2 — approved section: batch grouping + bulk publish.
    private List<AssignmentBatchViewModel> approvedBatchViewModels = new();
    private SelectionModel<string> approvedSelection = new();
    private string approvedSearch = string.Empty;
    private bool showPublishConfirm;

    // UI-2.2 — Pending and Published are batched the same way as Approved.
    // UI-2.3 — and now have their own selection, for bulk delete.
    private List<AssignmentBatchViewModel> pendingBatchViewModels = new();
    private List<AssignmentBatchViewModel> publishedBatchViewModels = new();
    private SelectionModel<string> pendingSelection = new();
    private SelectionModel<string> publishedSelection = new();

    // UI-2.2 — one cached thumbnail data URL per DISTINCT presentation referenced by the loaded
    // assignments, built once per LoadDataAsync call. Every render path looks up this dictionary
    // instead of embedding a full-size image per row/batch — see PosterThumbnailCache.
    private Dictionary<string, string?> thumbnailById = new();

    // UI-2.3 — one bulk run (Publish or Delete) at a time, shared across all three sections.
    // runSection records which section's BulkRunPanel should show it — the other two sections'
    // panels pass Running=false/Result=null so progress/results never appear in the wrong place.
    private bool isRunning;
    private string? runSection;
    private string runVerb = string.Empty;
    private int runDone;
    private int runTotal;
    private BulkRunResult<Assignment>? runResult;
    private CancellationTokenSource? runCts;

    // UI-2.3 — bulk delete confirmation, shared by all three sections and by every single-row
    // Delete button (N = 1).
    private bool showDeleteConfirm;
    private string? deleteConfirmSection;
    private List<Assignment> deleteConfirmItems = new();

    private bool IsApprovedSearchActive => !string.IsNullOrWhiteSpace(approvedSearch);

    private List<Assignment> AllShownApproved => approvedBatchViewModels.SelectMany(ShownInApprovedBatch).ToList();

    private List<AssignmentBatchViewModel> ShownApprovedBatchViewModels =>
        approvedBatchViewModels.Where(b => ShownInApprovedBatch(b).Count > 0).ToList();

    private bool MatchesApprovedSearch(string? text) =>
        !IsApprovedSearchActive || (text != null && text.Contains(approvedSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private List<Assignment> ShownInApprovedBatch(AssignmentBatchViewModel vm)
    {
        if (!IsApprovedSearchActive || MatchesApprovedSearch(vm.PresentationTitle))
            return vm.Batch.Assignments.ToList();

        return vm.Batch.Assignments.Where(a => MatchesApprovedSearch(a.TargetTeam)).ToList();
    }

    // UI-2.2 — thumbnailById is built once per LoadDataAsync call, keyed by PresentationID; every
    // render path (Pending/Approved/Published) looks it up instead of computing its own image.
    private string? ThumbnailFor(string presentationId) =>
        thumbnailById.TryGetValue(presentationId, out var url) ? url : null;

    private Presentation? PresentationFor(string presentationId) =>
        presentations.FirstOrDefault(p => p.PresentationID == presentationId);

    // The full-size image is built only when PosterThumbnail's lightbox actually asks for it
    // (GetFullImageDataUrl), never eagerly during render.
    private string? FullImageFor(string presentationId) => PosterImage.ToDataUrl(PresentationFor(presentationId));

    // Shared by Pending, Approved, and Published — looks up each batch's presentation/schedule
    // from the already-loaded team-wide lists (presentations/schedules, below) once per batch,
    // never per row. Batches with more than 5 items start collapsed; 5 or fewer start expanded,
    // unless the batch already existed before this reload, in which case its expand/collapse
    // state is preserved instead.
    private List<AssignmentBatchViewModel> BuildBatchViewModels(
        IReadOnlyList<Assignment> source, List<AssignmentBatchViewModel> previous)
    {
        var batches = AssignmentBatchGrouper.Group(source);
        var previousExpansion = previous.ToDictionary(b => b.Batch.Key, b => b.IsExpanded);

        return batches.Select(batch =>
        {
            var presentation = presentations.FirstOrDefault(p => p.PresentationID == batch.Key.PresentationID);
            var schedule = schedules.FirstOrDefault(s => s.ScheduleID == batch.Key.ScheduleID);

            return new AssignmentBatchViewModel
            {
                Batch = batch,
                PresentationTitle = presentation?.Name ?? batch.Key.PresentationID,
                PresentationDescription = presentation?.Description,
                IsNewsOfWeek = presentation?.IsNewsOfWeek ?? false,
                IsWallpaper = presentation?.IsWallpaper ?? false,
                IsLogonScreen = presentation?.IsLogonScreen ?? false,
                ScheduleStart = schedule?.ScheduleStart,
                ScheduleEnd = schedule?.ScheduleEnd,
                DaysOfWeek = schedule?.DaysOfWeek ?? string.Empty,
                IsExpanded = previousExpansion.TryGetValue(batch.Key, out var wasExpanded)
                    ? wasExpanded
                    : batch.Count <= 5
            };
        }).ToList();
    }

    private void BuildAllBatches()
    {
        approvedBatchViewModels = BuildBatchViewModels(approvedAssignments, approvedBatchViewModels);
        pendingBatchViewModels = BuildBatchViewModels(pendingAssignments, pendingBatchViewModels);
        publishedBatchViewModels = BuildBatchViewModels(publishedAssignments, publishedBatchViewModels);

        // UI-2.3 — every reload (publish, bulk delete, or a plain page load) prunes all three
        // selections, not just Approved's.
        approvedSelection.RemoveMissing(approvedAssignments.Select(a => a.AssignmentID));
        pendingSelection.RemoveMissing(pendingAssignments.Select(a => a.AssignmentID));
        publishedSelection.RemoveMissing(publishedAssignments.Select(a => a.AssignmentID));
    }

    // UI-2.3 — the ids a "select all"/batch checkbox may operate on: only rows this user may
    // actually delete, so an ineligible row is excluded from bulk selection entirely rather than
    // merely shown unchecked.
    private List<string> EligiblePendingIds =>
        BulkDeleteSelection.EligibleIds(pendingAssignments, CanDelete, a => a.AssignmentID);

    private List<string> EligiblePublishedIds =>
        BulkDeleteSelection.EligibleIds(publishedAssignments, CanDeletePublished, a => a.AssignmentID);

    // Approved's checkbox selects for BOTH Publish and Delete, so it is never itself filtered by
    // delete-eligibility (an ineligible-for-delete row must stay selectable for Publish) — only
    // the Delete button's own count/run narrows the current selection down to deletable rows.
    private List<Assignment> DeletableSelectedApproved =>
        approvedAssignments.Where(a => approvedSelection.IsSelected(a.AssignmentID) && CanDelete(a)).ToList();

    // UI-2.2 — one cache lookup per DISTINCT PresentationID referenced by the loaded assignments,
    // never one per row/batch. A presentation with no match (deleted, or not yet loaded) maps to
    // null, which PosterThumbnail renders as its "No preview" placeholder.
    private async Task BuildThumbnailsAsync()
    {
        var map = new Dictionary<string, string?>();

        foreach (var presentationId in assignments.Select(a => a.PresentationID).Distinct())
        {
            var presentation = PresentationFor(presentationId);
            map[presentationId] = presentation != null
                ? await ThumbnailCache.GetThumbnailDataUrlAsync(presentation)
                : null;
        }

        thumbnailById = map;
    }

    private async Task ConfirmBulkPublish()
    {
        showPublishConfirm = false;
        var items = approvedAssignments.Where(a => approvedSelection.IsSelected(a.AssignmentID)).ToList();

        isRunning = true;
        runSection = "Approved";
        runVerb = "Publishing";
        runDone = 0;
        runTotal = items.Count;
        runResult = null;
        runCts = new CancellationTokenSource();
        StateHasChanged();

        var progress = new Progress<(int done, int total)>(p =>
        {
            runDone = p.done;
            runTotal = p.total;
            InvokeAsync(StateHasChanged);
        });

        var result = await BulkOperationRunner.RunAsync(
            items,
            async assignment =>
            {
                var publishResult = await PublishingService.PublishAssignmentAsync(
                    assignment.SourceTeam, assignment.AssignmentID);

                if (!publishResult.Success)
                    return BulkItemOutcome.Failure(publishResult.ErrorMessage);

                return publishResult.DistributionWarnings.Count > 0
                    ? BulkItemOutcome.Success(publishResult.DistributionWarnings[0])
                    : BulkItemOutcome.Success();
            },
            progress,
            runCts.Token);

        isRunning = false;
        runResult = result;
        runCts.Dispose();
        runCts = null;

        await LoadDataAsync();
        StateHasChanged();
    }

    private void StopRun() => runCts?.Cancel();

    // UI-2.3 — bulk delete confirmation, shared by every section and by single-row deletes.

    private string DeleteConfirmTitle => deleteConfirmSection == "Published" ? "Delete and withdraw" : "Delete assignments";

    private string DeleteConfirmDialogType => deleteConfirmSection == "Published" ? "danger" : "warning";

    private string DeleteConfirmButtonText =>
