    private void ShowDeleteConfirmForSelection(string section)
    {
        var items = section switch
        {
            "Pending" => pendingAssignments.Where(a => pendingSelection.IsSelected(a.AssignmentID)).ToList(),
            "Approved" => DeletableSelectedApproved,
            "Published" => publishedAssignments.Where(a => publishedSelection.IsSelected(a.AssignmentID)).ToList(),
            _ => new List<Assignment>()
        };

        if (items.Count == 0)
            return;

        deleteConfirmSection = section;
        deleteConfirmItems = items;
        showDeleteConfirm = true;
    }

    private void ShowDeleteConfirmForSingle(string section, Assignment assignment)
    {
        deleteConfirmSection = section;
        deleteConfirmItems = new List<Assignment> { assignment };
        showDeleteConfirm = true;
    }

    private void CancelDeleteConfirm()
    {
        showDeleteConfirm = false;
        deleteConfirmSection = null;
        deleteConfirmItems = new();
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        var section = deleteConfirmSection!;
        var items = deleteConfirmItems;
        deleteConfirmSection = null;
        deleteConfirmItems = new();

        await RunBulkDeleteAsync(section, items);
    }

    // UI-2.3 — the single bulk-delete run shared by Pending/Approved/Published and by every
    // single-row Delete (a one-item run). Each item calls AssignmentService.DeleteAssignmentAsync
    // directly — never the old single-item page handler — so BulkOperationRunner's own try/catch
    // maps UnauthorizedAccessException and anything else to a per-item failure outcome. Reloads
    // exactly once after the run ends, whether it completed, was stopped, or every item failed.
    private async Task RunBulkDeleteAsync(string section, List<Assignment> items)
    {
        isRunning = true;
        runSection = section;
        runVerb = "Deleting";
        runDone = 0;
        runTotal = items.Count;
        runResult = null;
        runCts = new CancellationTokenSource();
        StateHasChanged();

        var progress = new Progress<(int done, int total)>(p =>
        {
            runDone = p.done;
            runTotal = p.total;
            InvokeAsync(StateHasChanged);
        });

        var result = await BulkOperationRunner.RunAsync(
            items,
            async assignment =>
            {
                await AssignmentService.DeleteAssignmentAsync(assignment.SourceTeam, assignment.AssignmentID);
                return BulkItemOutcome.Success();
            },
            progress,
            runCts.Token);

        isRunning = false;
        runResult = result;
        runCts.Dispose();
        runCts = null;

        await LoadDataAsync();
        StateHasChanged();
    }

    private sealed class AssignmentBatchViewModel
