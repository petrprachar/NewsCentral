                // n == 1: name the one target team directly, rather than "1 team(s)".
                var devicesPhrase = n == 1
                    ? $"{deleteConfirmItems[0].TargetTeam}'s devices"
                    : $"the devices of {BulkDeleteSelection.DistinctTargetTeamCount(deleteConfirmItems)} team(s)";

                return $"Delete {n} published assignment(s)? The poster will be removed from " +
