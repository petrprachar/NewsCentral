    {
        public AssignmentBatch Batch { get; set; } = null!;
        public string PresentationTitle { get; set; } = string.Empty;
        public string? PresentationDescription { get; set; }
        public string? PresentationImageDataUrl { get; set; }
        public bool IsNewsOfWeek { get; set; }
        public bool IsWallpaper { get; set; }
        public bool IsLogonScreen { get; set; }
        public DateTime? ScheduleStart { get; set; }
        public DateTime? ScheduleEnd { get; set; }
        public string DaysOfWeek { get; set; } = string.Empty;
        public bool IsExpanded { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = AuthService.GetCurrentUser();
        currentTeamFolder = TeamContext.CurrentTeamFolderName;

        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (string.IsNullOrEmpty(currentTeamFolder))
        {
            errorMessage = "No team selected. Please select a team from the home page.";
            isLoading = false;
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Load ALL assignments for the current team (not just user's own)
            assignments = await AssignmentService.GetAssignmentsForTeamAsync(currentTeamFolder!);

            // Load presentations and schedules
            presentations = await PresentationService.GetPresentationsForTeamAsync(currentTeamFolder!);
            schedules = await ScheduleService.GetSchedulesForTeamAsync(currentTeamFolder!);

            BuildApprovedBatches();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Error loading assignments: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }
