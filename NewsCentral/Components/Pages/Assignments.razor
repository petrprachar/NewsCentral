@page "/assignments"
@using System.Globalization
@using NewsCentral.Services
@using NewsCentral.Models
@using NewsCentral.Formatting
@using NewsCentral.Components.Shared
@using NewsCentral.Ui
@using Microsoft.Extensions.Localization
@inject AssignmentService AssignmentService
@inject PresentationService PresentationService
@inject ScheduleService ScheduleService
@inject PublishingService PublishingService
@inject AuthenticationService AuthService
@inject TeamContextService TeamContext
@inject NavigationManager Navigation
@inject IStringLocalizer<Assignments> Localizer

<PageTitle>@Localizer["Assignments"]</PageTitle>

<div class="my-assignments-container">
    <div class="page-header">
        <h2>@Localizer["Assignments"]</h2>
        <p class="subtitle">@Localizer["ViewAndManageTeamAssignments"]</p>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading assignments...</p>
        </div>
    }
    else if (!assignments.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
            <h3>No assignments yet</h3>
            <p>Create your first assignment to get started</p>
        </div>
    }
    else
    {
        @* Pending Approval Section *@
        @if (pendingAssignments.Any())
        {
            <div class="section-header">
                <h4>⏳ Pending Approval (@pendingAssignments.Count)</h4>
            </div>

            @foreach (var assignment in pendingAssignments)
            {
                var presentation = presentations.FirstOrDefault(p => p.PresentationID == assignment.PresentationID);
                var schedule = schedules.FirstOrDefault(s => s.ScheduleID == assignment.ScheduleID);

                <div class="assignment-card pending-card">
                    <div class="card-content">
                        <div class="card-header-section">
                            <PosterThumbnail ImageDataUrl="@PosterImage.ToDataUrl(presentation)" Title="@presentation?.Name" Width="120" />
                            <div class="presentation-info">
                                <h3>@presentation?.Name</h3>
                                <p class="target-team">To: <strong>@assignment.TargetTeam</strong></p>

                                @* Display Type Badges *@
                                <div class="display-badges">
                                    @if (presentation?.IsNewsOfWeek == true)
                                    {
                                        <span class="display-badge news-badge">
                                            <i class="bi bi-newspaper"></i> News of the Week
                                        </span>
                                    }
                                    @if (presentation?.IsWallpaper == true)
                                    {
                                        <span class="display-badge wallpaper-badge">
                                            <i class="bi bi-image-fill"></i> Wallpaper
                                        </span>
                                    }
                                    @if (presentation?.IsLogonScreen == true)
                                    {
                                        <span class="display-badge logon-badge">
                                            <i class="bi bi-lock-fill"></i> Logon Screen
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="status-badge pending">Pending</span>
                        </div>

                        <p class="description"><strong>Comment:</strong> @presentation?.Description</p>

                        @if (schedule != null)
                        {
                            <div class="schedule-box">
                                <p class="schedule-label">Schedule:</p>
                                <p class="schedule-dates">@AssignmentDateFormat.DateOnly(schedule.ScheduleStart, CultureInfo.CurrentCulture) - @AssignmentDateFormat.DateOnly(schedule.ScheduleEnd, CultureInfo.CurrentCulture) | @GetDaysOfWeekString(schedule.DaysOfWeek)</p>
                            </div>
                        }

                        @if (CanDelete(assignment))
                        {
                            <div class="action-buttons">
                                @if (CanDelete(assignment))
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssignment(assignment)" disabled="@isDeleting">
                                        @if (isDeleting && deletingAssignmentId == assignment.AssignmentID)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash"></i>
                                        }
                                        Delete
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        @* Approved - Ready to Publish Section (UI-2: batch grouping + bulk publish) *@
        @if (approvedAssignments.Any())
        {
            <div class="section-header">
                <h4>✓ Approved - Ready to Publish (@approvedAssignments.Count)</h4>
            </div>

            <BulkRunPanel Running="isRunning" Done="runDone" Total="runTotal" Verb="@runVerb"
                          Result="runResult" OnStop="StopRun"
                          WarningSummaryFormat="{0} assignment(s) published with distribution warnings" />

            <div class="approved-toolbar">
                <input type="text" class="approved-search" placeholder="Search by team or presentation…"
                       @bind="approvedSearch" @bind:event="oninput" disabled="@isRunning" />
                <TriStateCheckbox State="@approvedSelection.StateOf(AllShownApproved.Select(a => a.AssignmentID))"
                                  OnToggle="@(() => approvedSelection.ToggleAll(AllShownApproved.Select(a => a.AssignmentID)))"
                                  Disabled="@isRunning"
                                  Label="@(IsApprovedSearchActive
                                      ? string.Format("Select all shown ({0})", AllShownApproved.Count)
                                      : string.Format("Select all ({0})", approvedAssignments.Count))" />
                <span class="approved-counter">@approvedSelection.Count of @approvedAssignments.Count selected</span>
                <button class="btn btn-success" @onclick="@(() => showPublishConfirm = true)"
                        disabled="@(approvedSelection.Count == 0 || isRunning)">
                    Publish @approvedSelection.Count
                </button>
            </div>

            @if (ShownApprovedBatchViewModels.Count == 0)
            {
                <p class="no-batches-match">No approved assignments match '@approvedSearch'.</p>
            }

            @foreach (var vm in ShownApprovedBatchViewModels)
            {
                var shownInBatch = ShownInApprovedBatch(vm);

                <div class="batch-card">
                    <div class="batch-header">
                        <TriStateCheckbox State="@approvedSelection.StateOf(shownInBatch.Select(a => a.AssignmentID))"
                                          OnToggle="@(() => approvedSelection.ToggleAll(shownInBatch.Select(a => a.AssignmentID)))"
                                          Disabled="@isRunning" />
                        <button type="button" class="batch-expand-toggle" @onclick="@(() => vm.IsExpanded = !vm.IsExpanded)">
                            <i class="bi @(vm.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        </button>
                        <PosterThumbnail ImageDataUrl="@vm.PresentationImageDataUrl" Title="@vm.PresentationTitle" Width="120" />
                        <div class="batch-header-main">
                            <div class="batch-title">@vm.PresentationTitle</div>
                            @if (vm.IsNewsOfWeek || vm.IsWallpaper || vm.IsLogonScreen)
                            {
                                <DisplayTypeBadges ShowNewsOfWeek="@vm.IsNewsOfWeek" ShowWallpaper="@vm.IsWallpaper" ShowLogonScreen="@vm.IsLogonScreen" />
                            }
                            @if (!string.IsNullOrWhiteSpace(vm.PresentationDescription))
                            {
                                <div class="batch-comment" title="@vm.PresentationDescription">
                                    <strong>Comment:</strong> @vm.PresentationDescription
                                </div>
                            }
                            <div class="batch-schedule">
                                Schedule:
                                @(vm.ScheduleStart.HasValue && vm.ScheduleEnd.HasValue
                                    ? AssignmentDateFormat.DateOnly(vm.ScheduleStart.Value, CultureInfo.CurrentCulture) + " - " + AssignmentDateFormat.DateOnly(vm.ScheduleEnd.Value, CultureInfo.CurrentCulture)
                                    : "—")
                                &nbsp;·&nbsp; Days: @GetDaysOfWeekString(vm.DaysOfWeek)
                            </div>
                            <div class="batch-meta">
                                Source: <strong>@vm.Batch.Key.SourceTeam</strong>
                                &nbsp;·&nbsp; @vm.Batch.Count teams
                                &nbsp;·&nbsp; @DisplayTime.Local(vm.Batch.CreatedUtc, "yyyy-MM-dd HH:mm")
                            </div>
                        </div>
                    </div>

                    @if (vm.IsExpanded)
                    {
                        <div class="batch-rows">
                            @foreach (var assignment in shownInBatch)
                            {
                                var isSelected = approvedSelection.IsSelected(assignment.AssignmentID);

                                <div class="batch-row @(isSelected ? "selected" : "")">
                                    <label class="batch-row-main">
                                        <input type="checkbox" checked="@isSelected" disabled="@isRunning"
                                               @onchange="@(e => approvedSelection.Set(assignment.AssignmentID, (bool)e.Value!))" />
                                        <span>@assignment.TargetTeam</span>
                                        @if (assignment.ApprovedDate.HasValue)
                                        {
                                            <span class="approval-date">| Approved: @AssignmentDateFormat.DateOnly(assignment.ApprovedDate.Value, CultureInfo.CurrentCulture)</span>
                                        }
                                    </label>
                                    <div class="batch-row-actions">
                                        @if (CanPublish(assignment))
                                        {
                                            <button class="btn btn-sm btn-success" disabled="@(isPublishing || isRunning)"
                                                    @onclick="@(() => PublishAssignment(assignment))">
                                                @if (isPublishing && publishingAssignmentId == assignment.AssignmentID)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-send"></i>
                                                }
                                                Publish
                                            </button>
                                        }
                                        @if (CanDelete(assignment))
                                        {
                                            <button class="btn btn-sm btn-outline-danger" disabled="@(isDeleting || isRunning)"
                                                    @onclick="@(() => DeleteAssignment(assignment))">
                                                @if (isDeleting && deletingAssignmentId == assignment.AssignmentID)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-trash"></i>
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* Published Section *@
        @if (publishedAssignments.Any())
        {
            <div class="section-header">
                <h4>☑ Published (@publishedAssignments.Count)</h4>
            </div>

            @foreach (var assignment in publishedAssignments)
            {
                var presentation = presentations.FirstOrDefault(p => p.PresentationID == assignment.PresentationID);
                var schedule = schedules.FirstOrDefault(s => s.ScheduleID == assignment.ScheduleID);

                <div class="assignment-card published-card">
                    <div class="card-content">
                        <div class="card-header-section">
                            <PosterThumbnail ImageDataUrl="@PosterImage.ToDataUrl(presentation)" Title="@presentation?.Name" Width="120" />
                            <div class="presentation-info">
                                <h3>@presentation?.Name</h3>
                                <p class="target-team">
                                    To: <strong>@assignment.TargetTeam</strong>
                                    @if (assignment.PublishedDate.HasValue)
                                    {
                                        <span class="approval-date">| Published: @AssignmentDateFormat.UtcTimestamp(assignment.PublishedDate.Value, CultureInfo.CurrentCulture)</span>
                                    }
                                </p>

                                @* Display Type Badges *@
                                <div class="display-badges">
                                    @if (presentation?.IsNewsOfWeek == true)
                                    {
                                        <span class="display-badge news-badge">
                                            <i class="bi bi-star-fill"></i> News of Week
                                        </span>
                                    }
                                    @if (presentation?.IsWallpaper == true)
                                    {
                                        <span class="display-badge wallpaper-badge">
                                            <i class="bi bi-image"></i> Wallpaper
                                        </span>
                                    }
                                    @if (presentation?.IsLogonScreen == true)
                                    {
                                        <span class="display-badge logon-badge">
                                            <i class="bi bi-lock"></i> Logon Screen
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="status-badge published">Published</span>
                        </div>

                        <p class="description"><strong>Comment:</strong> @presentation?.Description</p>

                        @if (schedule != null)
                        {
                            <div class="schedule-box">
                                <p class="schedule-label">Schedule:</p>
                                <p class="schedule-dates">@AssignmentDateFormat.DateOnly(schedule.ScheduleStart, CultureInfo.CurrentCulture) - @AssignmentDateFormat.DateOnly(schedule.ScheduleEnd, CultureInfo.CurrentCulture) | @GetDaysOfWeekString(schedule.DaysOfWeek)</p>
                            </div>
                        }

                        @if (assignment.PublishedPaths != null && assignment.PublishedPaths.Any())
                        {
                            <div class="published-files">
                                <p class="files-label">Published files:</p>
                                <ul class="file-list">
                                    @foreach (var path in assignment.PublishedPaths)
                                    {
                                        <li>@path</li>
                                    }
                                </ul>
                            </div>
                        }
                        @* ADD THIS SECTION - Delete button for Published *@
                        @if (CanDeletePublished(assignment))
                        {
                            <div class="action-buttons">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssignment(assignment)" disabled="@isDeleting">
                                    @if (isDeleting && deletingAssignmentId == assignment.AssignmentID)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-trash"></i>
                                    }
                                    Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-3">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @* M5a: distinct from errorMessage — the publish itself succeeded, only distribution failed. TODO(i18n). *@
    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @warningMessage
            <button type="button" class="btn-close" @onclick="() => warningMessage = null"></button>
        </div>
    }
</div>

<ConfirmDialog IsVisible="showPublishConfirm"
               Title="Publish assignments?"
               Message="@("Publish " + approvedSelection.Count + " assignment(s)?")"
               ConfirmText="Publish"
               CancelText="Cancel"
               DialogType="warning"
               OnConfirm="ConfirmBulkPublish"
               OnCancel="@(() => showPublishConfirm = false)" />

