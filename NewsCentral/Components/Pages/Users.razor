<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="@Localizer["DeleteUser"]"
               Message="@(userToDelete != null ? string.Format(Localizer["DeleteUserConfirm"].Value, userToDelete.DisplayName) : string.Empty)"
               ConfirmText="@Localizer["Delete"]"
               CancelText="@Localizer["Cancel"]"
               DialogType="danger"
               OnConfirm="ConfirmDeleteUser"
               OnCancel="CancelDeleteUser" />

@code {
    private List<User> users = new();
    private List<Team> teams = new();
    private bool isLoading = true;
    private bool showCreateDialog = false;
    private bool showTeamsDialog = false;
    private bool isSaving = false;

    private string username = string.Empty;
    private string displayName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string upn = string.Empty;
    private bool isSystemAdmin = false;
    private bool isActive = true;
    private string errorMessage = string.Empty;

    private User? editingUser = null;
    private User? managingUser = null;

    private bool showDeleteConfirm = false;
    private User? userToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsSystemAdmin() && !AuthService.IsTeamAdminOfAnyTeam())
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadData();
    }

    // SystemAdmin may administer every team; a TeamAdmin only the team(s) where
    // they hold the TeamAdmin role. Controls which role checkboxes are editable.
    private bool CanAdministerTeam(string teamId) =>
        AuthService.HasRole(teamId, "TeamAdmin");

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            users = await UserService.GetAllUsersAsync();
            teams = await TeamService.GetAllTeamsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateDialog()
    {
        editingUser = null;
        username = string.Empty;
        displayName = string.Empty;
        email = string.Empty;
        password = string.Empty;
        upn = string.Empty;
        isSystemAdmin = false;
        isActive = true;
        errorMessage = string.Empty;
        showCreateDialog = true;
    }

    private void EditUser(User user)
    {
        editingUser = user;
        username = user.Username;
        displayName = user.DisplayName;
        email = user.Email;
        upn = user.UPN ?? string.Empty;
        isActive = user.IsActive;
        errorMessage = string.Empty;
        showCreateDialog = true;
    }

    private void CloseCreateDialog()
    {
        showCreateDialog = false;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(displayName))
        {
            errorMessage = Localizer["UsernameDisplayNameRequired"];
            return;
        }

        if (editingUser == null && string.IsNullOrWhiteSpace(password))
        {
            errorMessage = Localizer["PasswordRequired"];
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            if (editingUser == null)
            {
                await UserService.CreateUserWithUPNAsync(
                    username,
                    email,
                    displayName,
                    password,
                    isSystemAdmin,
                    string.IsNullOrWhiteSpace(upn) ? null : upn.Trim());
            }
            else
            {
                await UserService.UpdateUserWithUPNAsync(
                    editingUser.UserID,
                    email,
                    displayName,
                    isActive,
                    string.IsNullOrWhiteSpace(upn) ? null : upn.Trim());
            }

            await LoadData();
            CloseCreateDialog();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ManageTeams(User user)
    {
        managingUser = user;
        errorMessage = string.Empty;
        showTeamsDialog = true;
    }

    private void CloseTeamsDialog()
    {
        showTeamsDialog = false;
        managingUser = null;
    }

    private async Task ToggleTeamAssignment(Team team, bool isAssigned)
    {
        if (managingUser == null) return;

        try
        {
            if (isAssigned)
            {
                await UserService.AssignUserToTeamAsync(
                    managingUser.UserID,
                    team.TeamID,
                    team.FolderName,
                    new List<string> { "ContentAuthor" });
            }
            else
            {
                await UserService.RemoveUserFromTeamAsync(managingUser.UserID, team.TeamID);
            }

            await LoadData();
            managingUser = users.FirstOrDefault(u => u.UserID == managingUser.UserID);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ToggleRole(Team team, string role, bool isChecked)
    {
        if (managingUser == null) return;

        try
        {
            var teamRole = managingUser.TeamRoles.FirstOrDefault(tr => tr.TeamID == team.TeamID);
            if (teamRole == null) return;

            var roles = new List<string>(teamRole.Roles);

            if (isChecked && !roles.Contains(role))
            {
                roles.Add(role);
            }
            else if (!isChecked && roles.Contains(role))
            {
                roles.Remove(role);
            }

            // Must have at least one role
            if (roles.Count == 0)
            {
                errorMessage = Localizer["MustHaveRole"];
                return;
            }

            await UserService.UpdateTeamRolesAsync(managingUser.UserID, team.TeamID, roles);

            await LoadData();
            managingUser = users.FirstOrDefault(u => u.UserID == managingUser.UserID);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void DeleteUser(User user)
    {
        userToDelete = user;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteUser()
    {
        if (userToDelete == null) return;

        try
        {
            await UserService.DeleteUserAsync(userToDelete.UserID);
            await LoadData();
            showDeleteConfirm = false;
            userToDelete = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting user: {ex.Message}";
            showDeleteConfirm = false;
        }
    }

    private void CancelDeleteUser()
    {
        showDeleteConfirm = false;
        userToDelete = null;
    }
}
