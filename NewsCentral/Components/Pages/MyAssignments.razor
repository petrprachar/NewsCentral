@page "/my-assignments"
@inject Services.AssignmentService AssignmentService
@inject Services.PresentationService PresentationService
@inject Services.ScheduleService ScheduleService
@inject Services.TeamService TeamService
@inject Services.PublishingService PublishingService
@inject Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@using NewsCentral.Components.Shared
@using NewsCentral.Models

<PageTitle>My Assignments - NewsCentral</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>My Assignments</h1>
        <p class="subtitle">View and publish your content assignments</p>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading assignments...</div>
    }
    else if (myAssignments.Count == 0)
    {
        <div class="empty-state">
            <h3>No Assignments Yet</h3>
            <p>You haven't created any assignments</p>
            <a href="/presentations" class="btn btn-primary">Create Assignment</a>
        </div>
    }
    else
    {
        <!-- Pending Approval -->
        @if (pendingAssignments.Count > 0)
        {
            <div class="section">
                <h2>⏳ Pending Approval (@pendingAssignments.Count)</h2>
                <div class="assignments-list">
                    @foreach (var item in pendingAssignments)
                    {
                        <div class="assignment-card pending">
                            <div class="assignment-header">
                                <div>
                                    <h3>@item.PresentationName</h3>
                                    <p class="meta">To: <strong>@item.TargetTeamName</strong></p>
                                </div>
                                <div class="status-badge warning">Pending</div>
                            </div>

                            <div class="assignment-body">
                                <p class="description">@item.PresentationDescription</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Approved Assignments Ready to Publish -->
        @if (approvedAssignments.Count > 0)
        {
            <div class="section">
                <h2>✓ Approved - Ready to Publish (@approvedAssignments.Count)</h2>
                <div class="assignments-list">
                    @foreach (var item in approvedAssignments)
                    {
                        <div class="assignment-card approved">
                            <div class="assignment-header">
                                <div>
                                    <h3>@item.PresentationName</h3>
                                    <p class="meta">
                                        To: <strong>@item.TargetTeamName</strong> |
                                        Approved: @item.Assignment.ApprovedDate?.ToString("MMM dd, yyyy")
                                    </p>
                                </div>
                                <div class="status-badge success">Approved</div>
                            </div>

                            <div class="assignment-body">
                                <p class="description">@item.PresentationDescription</p>

                                <div class="schedule-info">
                                    <strong>Schedule:</strong>
                                    @item.ScheduleStart.ToString("MMM dd") - @item.ScheduleEnd.ToString("MMM dd, yyyy") |
                                    @FormatDaysOfWeek(item.DaysOfWeek)
                                </div>
                            </div>

                            <button @onclick="() => PublishAssignment(item)"
                                    class="btn btn-success"
                                    disabled="@(isPublishing && publishingId == item.Assignment.AssignmentID)">
                                @(isPublishing && publishingId == item.Assignment.AssignmentID ? "📤 Publishing..." : "📤 Publish")
                            </button>

                        </div>
                    }
                </div>
            </div>
        }

        <!-- Published -->
        @if (publishedAssignments.Count > 0)
        {
            <div class="section">
                <h2>✅ Published (@publishedAssignments.Count)</h2>
                <div class="assignments-list">
                    @foreach (var item in publishedAssignments)
                    {
                        <div class="assignment-card published">
                            <div class="assignment-header">
                                <div>
                                    <h3>@item.PresentationName</h3>
                                    <p class="meta">
                                        To: <strong>@item.TargetTeamName</strong> |
                                        Published: @item.Assignment.PublishedDate?.ToString("MMM dd, yyyy")
                                    </p>
                                </div>
                                <div class="status-badge published-badge">Published</div>
                            </div>

                            <div class="assignment-body">
                                <p class="description">@item.PresentationDescription</p>

                                @if (item.Assignment.PublishedPaths.Count > 0)
                                {
                                    <div class="published-files">
                                        <strong>Published files:</strong>
                                        <ul>
                                            @foreach (var path in item.Assignment.PublishedPaths)
                                            {
                                                <li>@path</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Rejected -->
        @if (rejectedAssignments.Count > 0)
        {
            <div class="section">
                <h2>✗ Rejected (@rejectedAssignments.Count)</h2>
                <div class="assignments-list">
                    @foreach (var item in rejectedAssignments)
                    {
                        <div class="assignment-card rejected">
                            <div class="assignment-header">
                                <div>
                                    <h3>@item.PresentationName</h3>
                                    <p class="meta">To: <strong>@item.TargetTeamName</strong></p>
                                </div>
                                <div class="status-badge danger">Rejected</div>
                            </div>

                            <div class="assignment-body">
                                <p class="description">@item.PresentationDescription</p>

                                @if (!string.IsNullOrEmpty(item.Assignment.RejectionReason))
                                {
                                    <div class="rejection-reason">
                                        <strong>Rejection reason:</strong>
                                        <p>@item.Assignment.RejectionReason</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="toast success">
            ✓ @successMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="toast error">
            ✗ @errorMessage
        </div>
    }
</div>

<style>
    .page-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0;
        }

    .subtitle {
        color: #666;
        margin: 5px 0 0 0;
    }

    .loading {
        text-align: center;
        padding: 40px;
        color: #666;
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .section {
        margin-bottom: 40px;
    }

        .section h2 {
            margin: 0 0 20px 0;
            color: #333;
            font-size: 20px;
        }

    .assignments-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .assignment-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-left: 4px solid #ccc;
    }

        .assignment-card.approved {
            border-left-color: #28a745;
        }

        .assignment-card.pending {
            border-left-color: #ffc107;
        }

        .assignment-card.published {
            border-left-color: #17a2b8;
        }

        .assignment-card.rejected {
            border-left-color: #dc3545;
        }

    .assignment-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

        .assignment-header h3 {
            margin: 0;
            color: #333;
        }

    .meta {
        color: #666;
        margin: 5px 0 0 0;
        font-size: 14px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .status-badge.success {
            background: #d4edda;
            color: #155724;
        }

        .status-badge.warning {
            background: #fff3cd;
            color: #856404;
        }

        .status-badge.published-badge {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-badge.danger {
            background: #f8d7da;
            color: #721c24;
        }

    .assignment-body {
        margin-bottom: 15px;
    }

    .description {
        color: #666;
        margin-bottom: 10px;
    }

    .schedule-info {
        padding: 10px;
        background: #f8f9fa;
        border-radius: 5px;
        font-size: 14px;
        color: #333;
    }

    .published-files {
        margin-top: 10px;
        padding: 10px;
        background: #e7f3ff;
        border-radius: 5px;
        font-size: 13px;
    }

        .published-files ul {
            margin: 5px 0 0 0;
            padding-left: 20px;
        }

        .published-files li {
            color: #666;
            margin: 3px 0;
        }

    .rejection-reason {
        margin-top: 10px;
        padding: 10px;
        background: #fff3cd;
