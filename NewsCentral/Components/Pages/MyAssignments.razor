</style>

@code {
    private List<AssignmentViewModel> myAssignments = new();
    private List<AssignmentViewModel> approvedAssignments = new();
    private List<AssignmentViewModel> pendingAssignments = new();
    private List<AssignmentViewModel> publishedAssignments = new();
    private List<AssignmentViewModel> rejectedAssignments = new();

    private bool isLoading = true;
    private bool isPublishing = false;
    private string? publishingId = null;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadMyAssignments();
    }

    private async Task LoadMyAssignments()
    {
        // System.Diagnostics.Debug.WriteLine("=== LoadMyAssignments START ===");
        // System.Diagnostics.Debug.WriteLine($"Time: {DateTime.Now:HH:mm:ss.fff}");

        isLoading = true;

        // CRITICAL: Clear all lists first
        myAssignments.Clear();
        approvedAssignments.Clear();
        pendingAssignments.Clear();
        publishedAssignments.Clear();
        rejectedAssignments.Clear();

        try
        {
            var currentUser = AuthService.GetCurrentUser();
            if (currentUser == null) return;

            var allAssignments = await AssignmentService.GetAllAssignmentsAsync();
            var allTeams = await TeamService.GetAllTeamsAsync();

            // System.Diagnostics.Debug.WriteLine($"Total assignments in system: {allAssignments.Count}");

            // Filter assignments created by current user
            var userAssignments = allAssignments
                .Where(a => a.CreatedBy == currentUser.UserID)
                .OrderByDescending(a => a.DateCreated)
                .ToList();

            // System.Diagnostics.Debug.WriteLine($"User's assignments: {userAssignments.Count}");

            foreach (var assignment in userAssignments)
            {
                // System.Diagnostics.Debug.WriteLine($"Assignment {assignment.AssignmentID}: Status={assignment.Status}");


                // Load presentation details
                var presentation = await PresentationService.GetPresentationAsync(
                    assignment.SourceTeam,
                    assignment.PresentationID);

                if (presentation is null)
                {
                    // System.Diagnostics.Debug.WriteLine($"WARNING: Presentation {assignment.PresentationID} not found for assignment {assignment.AssignmentID}");
                    continue;
                }

                var targetTeam = allTeams.FirstOrDefault(t => t.FolderName == assignment.TargetTeam);

                // Load schedule
                var schedule = await ScheduleService.GetScheduleAsync(
                    assignment.SourceTeam,
                    assignment.ScheduleID);

                var viewModel = new AssignmentViewModel
                {
                    Assignment = assignment,
                    PresentationName = presentation.Name,
                    PresentationDescription = presentation.Description,
                    TargetTeamName = targetTeam?.Name ?? assignment.TargetTeam,
                    ScheduleStart = schedule?.ScheduleStart ?? DateTime.MinValue,
                    ScheduleEnd = schedule?.ScheduleEnd ?? DateTime.MaxValue,
                    DaysOfWeek = schedule?.DaysOfWeek ?? ""
                };

                myAssignments.Add(viewModel);
            }

            // Group by status
            approvedAssignments = myAssignments
                .Where(a => a.Assignment.Status == AssignmentStatus.Approved)
                .OrderByDescending(a => a.Assignment.ApprovedDate ?? a.Assignment.DateCreated)
                .ToList();

            pendingAssignments = myAssignments
                .Where(a => a.Assignment.Status == AssignmentStatus.PendingApproval)
                .OrderByDescending(a => a.Assignment.DateCreated)
                .ToList();

            publishedAssignments = myAssignments
                .Where(a => a.Assignment.Status == AssignmentStatus.Published)
                .OrderByDescending(a => a.Assignment.PublishedDate ?? a.Assignment.DateCreated)
                .ToList();

            rejectedAssignments = myAssignments
                .Where(a => a.Assignment.Status == AssignmentStatus.Rejected)
                .OrderByDescending(a => a.Assignment.RejectedDate ?? a.Assignment.DateCreated)
                .ToList();

            // System.Diagnostics.Debug.WriteLine($"Pending: {pendingAssignments.Count}");
            // System.Diagnostics.Debug.WriteLine($"Approved: {approvedAssignments.Count}");
            // System.Diagnostics.Debug.WriteLine($"Published: {publishedAssignments.Count}");
            // System.Diagnostics.Debug.WriteLine($"Rejected: {rejectedAssignments.Count}");
        }
        catch (Exception ex)
        {
            // System.Diagnostics.Debug.WriteLine($"ERROR in LoadMyAssignments: {ex.Message}");
            errorMessage = $"Error loading assignments: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Force UI update

            // Print all assignments with their status
            foreach (var item in myAssignments)
            {
                // System.Diagnostics.Debug.WriteLine($"  {item.PresentationName} → {item.Assignment.Status}");
            }

            // System.Diagnostics.Debug.WriteLine("=== LoadMyAssignments END ===");
        }
    }

    private async Task PublishAssignment(AssignmentViewModel item)
    {
        // System.Diagnostics.Debug.WriteLine($"=== PUBLISH START ===");
        // System.Diagnostics.Debug.WriteLine($"Assignment: {item.Assignment.AssignmentID}");

        isPublishing = true;
        publishingId = item.Assignment.AssignmentID;
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();

        try
        {
            // System.Diagnostics.Debug.WriteLine("Calling PublishingService...");

            var result = await PublishingService.PublishAssignmentAsync(
                item.Assignment.SourceTeam,
                item.Assignment.AssignmentID);

            // System.Diagnostics.Debug.WriteLine($"Result: Success={result.Success}");
            // System.Diagnostics.Debug.WriteLine($"Result: Message={result.Message}");
            // System.Diagnostics.Debug.WriteLine($"Result: ErrorMessage={result.ErrorMessage}");
            // System.Diagnostics.Debug.WriteLine($"Result: PublishedPaths Count={result.PublishedPaths?.Count ?? 0}");

            if (result.Success)
            {
                // System.Diagnostics.Debug.WriteLine($"Published {result.PublishedPaths?.Count ?? 0} files");

                successMessage = result.Message;
                StateHasChanged();

                // Show success message briefly, then reload page
                // System.Diagnostics.Debug.WriteLine("Waiting 1.5 seconds before navigation...");
                await Task.Delay(1500);

                // Force complete page reload to show updated status
                Navigation.NavigateTo("/my-assignments", forceLoad: true);

                // System.Diagnostics.Debug.WriteLine("Navigation.NavigateTo called");
            }
            else
            {
                // System.Diagnostics.Debug.WriteLine($"Publishing failed: {result.ErrorMessage}");
                errorMessage = result.ErrorMessage;
                StateHasChanged();

                await Task.Delay(5000);
                errorMessage = string.Empty;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // System.Diagnostics.Debug.WriteLine($"EXCEPTION: {ex.Message}");
            // System.Diagnostics.Debug.WriteLine($"Type: {ex.GetType().Name}");
            // System.Diagnostics.Debug.WriteLine($"Message: {ex.Message}");
            // System.Diagnostics.Debug.WriteLine($"Stack: {ex.StackTrace}");

            errorMessage = $"Publishing error: {ex.Message}";
            StateHasChanged();

            await Task.Delay(5000);
            errorMessage = string.Empty;
            StateHasChanged();
        }
        finally
        {
            isPublishing = false;
            publishingId = null;
            StateHasChanged();
            // System.Diagnostics.Debug.WriteLine($"=== PUBLISH END ===");
        }
    }

    private string FormatDaysOfWeek(string daysOfWeek)
    {
        if (string.IsNullOrEmpty(daysOfWeek)) return "None";

        var days = daysOfWeek.Split(',').Select(int.Parse).ToList();
        var dayNames = new List<string>();

        foreach (var day in days)
        {
            dayNames.Add(day switch
            {
                1 => "Mon",
                2 => "Tue",
                3 => "Wed",
                4 => "Thu",
                5 => "Fri",
                6 => "Sat",
                7 => "Sun",
                _ => ""
            });
        }

        return string.Join(", ", dayNames);
    }

    private class AssignmentViewModel
    {
        public Assignment Assignment { get; set; } = null!;
        public string PresentationName { get; set; } = string.Empty;
        public string PresentationDescription { get; set; } = string.Empty;
        public string TargetTeamName { get; set; } = string.Empty;
        public DateTime ScheduleStart { get; set; }
        public DateTime ScheduleEnd { get; set; }
        public string DaysOfWeek { get; set; } = string.Empty;
    }
}
