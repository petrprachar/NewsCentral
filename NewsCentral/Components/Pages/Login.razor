@page "/login"
@using NewsCentral.Services
@using NewsCentral.Models
@using Microsoft.Extensions.Localization

@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject TeamService TeamService
@inject TeamContextService TeamContext
@inject IStringLocalizer<Login> Localizer
@inject WindowsIdentityService WindowsIdentityService

<PageTitle>@Localizer["Login"] - @Localizer["AppTitle"]</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1>@Localizer["AppTitle"]</h1>
        <p class="subtitle">Content Management System</p>

        <div class="form-group">
            <label>@Localizer["Username"]:</label>
            <input type="text" @bind="username" class="form-control" 
                   placeholder="@Localizer["Username"]" />
        </div>

        <div class="form-group">
            <label>@Localizer["Password"]:</label>
            <input type="password" @bind="password" class="form-control" 
                   placeholder="@Localizer["Password"]" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button @onclick="HandleLogin" class="btn btn-primary" disabled="@isLoggingIn">
            @(isLoggingIn ? Localizer["LoadingPleaseWait"] : Localizer["Login"])
        </button>

        <div class="first-time-hint">
            <p>First time? Default credentials: admin / admin</p>
        </div>

        <div class="reset-password-link">
            <a href="/reset-admin">Forgot password? Reset Admin Password</a>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .login-card {
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    .login-card h1 {
        text-align: center;
        color: #333;
        margin: 0 0 10px 0;
    }

    .subtitle {
        text-align: center;
        color: #666;
        margin: 0 0 30px 0;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        color: #333;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
    }

    .btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: #5568d3;
    }

    .btn-primary:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    .alert {
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .first-time-hint {
        text-align: center;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .first-time-hint p {
        color: #666;
        font-size: 13px;
        margin: 0;
    }

    .reset-password-link {
        text-align: center;
        margin-top: 15px;
    }

    .reset-password-link a {
        color: #dc3545;
        font-size: 14px;
        text-decoration: none;
    }

    .reset-password-link a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoggingIn = false;

    protected override async Task OnInitializedAsync()
    {
        System.Diagnostics.Debug.WriteLine("=== Login Page: OnInitializedAsync START ===");
    
        try
        {
            System.Diagnostics.Debug.WriteLine("Step 1: About to call TryAutoLoginAsync");
        
            var autoLoginUser = await AuthService.TryAutoLoginAsync();
        
            System.Diagnostics.Debug.WriteLine($"Step 2: TryAutoLoginAsync returned: {(autoLoginUser != null ? "User found" : "null")}");
        
            if (autoLoginUser != null)
            {
                System.Diagnostics.Debug.WriteLine($"✓ Auto-login successful: {autoLoginUser.Username}");
                System.Diagnostics.Debug.WriteLine("Step 3: About to navigate to dashboard");
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
        
            System.Diagnostics.Debug.WriteLine("Auto-login not available, showing login form");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"=== ERROR IN OnInitializedAsync ===");
            System.Diagnostics.Debug.WriteLine($"Exception Type: {ex.GetType().Name}");
            System.Diagnostics.Debug.WriteLine($"Message: {ex.Message}");
            System.Diagnostics.Debug.WriteLine($"Stack Trace: {ex.StackTrace}");
        
            if (ex.InnerException != null)
            {
                System.Diagnostics.Debug.WriteLine($"Inner Exception: {ex.InnerException.Message}");
            }
        
            errorMessage = $"Login initialization error: {ex.Message}";
        }
    
        System.Diagnostics.Debug.WriteLine("=== Login Page: OnInitializedAsync END ===");
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(username, password);

            if (result != null)
            {
                System.Diagnostics.Debug.WriteLine($"Login successful: {result.Username}");

                // NEW: Auto-select the first available team
                try
                {
                    var teams = await TeamService.GetAllTeamsAsync();
                    System.Diagnostics.Debug.WriteLine($"Found {teams.Count} teams");

                    if (teams.Count > 0)
                    {
                        var firstTeam = teams[0];
                        TeamContext.SetCurrentTeam(firstTeam.TeamID, firstTeam.FolderName);
                        System.Diagnostics.Debug.WriteLine($"Auto-selected team: {firstTeam.Name} ({firstTeam.FolderName})");
                    }
                    else
                    {
                        System.Diagnostics.Debug.WriteLine("No teams available - user will need to select one");
                    }
                }
                catch (Exception teamEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Error loading teams: {teamEx.Message}");
                    // Don't fail login if team selection fails
                }

                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = Localizer["InvalidCredentials"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Login error: {ex.Message}");
        }
    }
}