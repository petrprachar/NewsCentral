@page "/login"
@using NewsCentral.Services
@using NewsCentral.Models
@using Microsoft.Extensions.Localization

@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject TeamService TeamService
@inject TeamContextService TeamContext
@inject IStringLocalizer<Login> Localizer
@inject WindowsIdentityService WindowsIdentityService

<PageTitle>@Localizer["Login"] - @Localizer["AppTitle"]</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1>@Localizer["AppTitle"]</h1>
        <p class="subtitle">Content Management System</p>

        <div class="form-group">
            <label>@Localizer["Username"]:</label>
            <input type="text" @bind="username" class="form-control" 
                   placeholder="@Localizer["Username"]" />
        </div>

        <div class="form-group">
            <label>@Localizer["Password"]:</label>
            <input type="password" @bind="password" class="form-control" 
                   placeholder="@Localizer["Password"]" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button @onclick="HandleLogin" class="btn btn-primary" disabled="@isLoggingIn">
            @(isLoggingIn ? Localizer["LoadingPleaseWait"] : Localizer["Login"])
        </button>

        @if (showUpnButton)
        {
            <button @onclick="HandleUpnLogin" class="btn btn-secondary" disabled="@(isLoggingIn || !upnDetected)">
                @UpnButtonText
            </button>
            @if (!upnDetected)
            {
                <p class="upn-hint">@Localizer["UpnNotDetected"]</p>
            }
        }

        <div class="first-time-hint">
            <p>First time? Default credentials: admin / admin</p>
        </div>

        <div class="reset-password-link">
            <a href="/reset-admin">Forgot password? Reset Admin Password</a>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .login-card {
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    .login-card h1 {
        text-align: center;
        color: #333;
        margin: 0 0 10px 0;
    }

    .subtitle {
        text-align: center;
        color: #666;
        margin: 0 0 30px 0;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        color: #333;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
    }

    .btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: #5568d3;
    }

    .btn-primary:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: white;
        color: #667eea;
        border: 1px solid #667eea;
        margin-top: 10px;
    }

    .btn-secondary:hover:not(:disabled) {
        background: #f0f1fd;
    }

    .btn-secondary:disabled {
        background: #f5f5f5;
        color: #999;
        border-color: #ddd;
        cursor: not-allowed;
    }

    .upn-hint {
        text-align: center;
        color: #999;
        font-size: 12px;
        margin: 6px 0 0 0;
    }

    .alert {
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .first-time-hint {
        text-align: center;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .first-time-hint p {
        color: #666;
        font-size: 13px;
        margin: 0;
    }

    .reset-password-link {
        text-align: center;
        margin-top: 15px;
    }

    .reset-password-link a {
        color: #dc3545;
        font-size: 14px;
        text-decoration: none;
    }

    .reset-password-link a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoggingIn = false;

    // UPN Login button — visible only when Authentication:EnableAutoLogin is true. Detection runs
    // once at page load; the button never logs anyone in without a click.
    private bool showUpnButton = false;
    private bool upnDetected = false;
    private string? detectedUpn;

    private string UpnButtonText =>
        upnDetected
            ? $"{Localizer["UpnLogin"].Value} ({detectedUpn})"
            : Localizer["UpnLogin"].Value;

    protected override async Task OnInitializedAsync()
    {
        showUpnButton = WindowsIdentityService.IsAutoLoginEnabled();

        if (showUpnButton)
        {
            // GetCurrentUserUPN() shells out to `whoami /upn` when not in mock mode — run it off
            // the UI thread so page load stays responsive.
            detectedUpn = await Task.Run(() => WindowsIdentityService.GetCurrentUserUPN());
            upnDetected = !string.IsNullOrEmpty(detectedUpn);
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        isLoggingIn = true;

        try
        {
            var user = await AuthService.LoginAsync(username, password);

            if (user != null)
            {
                await CompleteLoginAsync(user);
            }
            else
            {
                errorMessage = Localizer["InvalidCredentials"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    private async Task HandleUpnLogin()
    {
        errorMessage = string.Empty;
        isLoggingIn = true;

        try
        {
            var result = await AuthService.LoginWithUpnAsync();

            switch (result.Outcome)
            {
                case UpnLoginOutcome.Success:
                    await CompleteLoginAsync(result.User!);
                    break;
                case UpnLoginOutcome.NoAccountForUpn:
                    errorMessage = Localizer["NoAccountForUpn", result.Upn ?? string.Empty];
                    break;
                case UpnLoginOutcome.UpnNotDetected:
                    errorMessage = Localizer["UpnNotDetected"];
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            System.Diagnostics.Debug.WriteLine($"UPN login error: {ex.Message}");
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    // Shared by both login paths: auto-select the first available team (moved from the old
    // HandleLogin, not rewritten), then navigate home without forceLoad — MainLayout refreshes via
    // AuthService.OnAuthenticationStateChanged, which both LoginAsync and LoginWithUpnAsync raise.
    private async Task CompleteLoginAsync(User user)
    {
        try
        {
            var teams = await TeamService.GetAllTeamsAsync();

            if (teams.Count > 0)
            {
                var firstTeam = teams[0];
                TeamContext.SetCurrentTeam(firstTeam.TeamID, firstTeam.FolderName);
            }
        }
        catch (Exception teamEx)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading teams: {teamEx.Message}");
            // Don't fail login if team selection fails
        }

        Navigation.NavigateTo("/");
    }
}