@page "/presentations"
@inject Services.PresentationService PresentationService
@inject Services.TeamService TeamService
@inject Services.TeamContextService TeamContext
@inject Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject UserService UserService

@using NewsCentral.Components.Shared
@using NewsCentral.Models

<PageTitle>Presentations - NewsCentral</PageTitle>

<div class="page-container">
    @if (!TeamContext.HasTeamSelected())
    {
        <div class="no-team-selected">
            <h2>No Team Selected</h2>
            <p>Please select a team first</p>
            <TeamSelector />
        </div>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1>Presentations</h1>
                <p class="team-context">Team: @currentTeamName</p>
            </div>
            @if (canCreate)
            {
                <a href="/presentations/create" class="btn btn-primary">+ Create Presentation</a>
            }
        </div>

        @if (isLoading)
        {
            <div class="loading">Loading presentations...</div>
        }
        else if (presentations.Count == 0)
        {
            <div class="empty-state">
                <h3>No presentations yet</h3>
                @if (canCreate)
                {
                    <p>Create your first presentation to get started</p>
                }
                else
                {
                    <p>No presentations available for this team</p>
                }
            </div>
        }
        else
        {
            <div class="presentations-grid">
                @foreach (var presentation in presentations)
                {
                    <div class="presentation-card">
                        <div class="presentation-image">
                            @if (!string.IsNullOrEmpty(presentation.OriginalImagePath))
                            {
                                @if (imageCache.ContainsKey(presentation.PresentationID))
                                {
                                    <img src="data:image/jpeg;base64,@GetImagePreview(presentation)" alt="@presentation.Name" />
                                }
                                else
                                {
                                    <div class="image-loading">
                                        <span>⏳</span>
                                        <small>Loading...</small>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-image">No Image</div>
                            }
                        </div>

                        <div class="presentation-content">
                            <h3>@presentation.Name</h3>

                            <span class="creator-badge">
                                Created by: @GetCreatorName(presentation.CreatedBy)
                            </span>

                            <p class="description">@presentation.Description</p>

                            <div class="presentation-meta">
                                <small>Created: @presentation.DateCreated.ToString("yyyy-MM-dd")</small>
                                <small>Version: @presentation.Version</small>
                            </div>

                            @if (CanEditPresentation(presentation))
                            {
                                <div class="presentation-actions">
                                    <a href="/presentations/edit/@presentation.PresentationID" class="btn btn-secondary">Edit</a>
                                    @if (!string.IsNullOrEmpty(presentation.GeneratedImagePath))
                                    {
                                        <a href="/presentations/@presentation.PresentationID/assign" class="btn btn-primary">Assign</a>
                                    }
                                    <button @onclick="() => DeletePresentation(presentation)" class="btn btn-danger">Delete</button>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<ConfirmDialog 
    IsVisible="@showDeleteConfirm"
    Title="Delete Presentation"
    Message="@($"Are you sure you want to delete '{presentationToDelete?.Name}'? This action cannot be undone.")"
    ConfirmText="Delete"
    CancelText="Cancel"
    DialogType="danger"
    OnConfirm="ConfirmDelete"
    OnCancel="CancelDelete" />

<style>
