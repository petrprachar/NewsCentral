</style>

@code {
    private List<Presentation> presentations = new();
    private List<Team> teams = new();
    private Dictionary<string, string> imageCache = new();
    private bool isLoading = true;
    private bool canCreate = false;
    private string currentTeamName = string.Empty;

    private bool showDeleteConfirm = false;
    private Presentation? presentationToDelete = null;

    private Dictionary<string, string> userNames = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Load user names for display
        await LoadUserNames();

        teams = await TeamService.GetAllTeamsAsync();

        if (TeamContext.HasTeamSelected())
        {
            await LoadPresentations();
        }

        TeamContext.OnTeamChanged += async () =>
        {
            await LoadPresentations();
            StateHasChanged();
        };
    }

    private async Task LoadPresentations()
    {
        isLoading = true;
        imageCache.Clear();

        var teamId = TeamContext.GetCurrentTeamId();
        var teamFolderName = TeamContext.GetCurrentTeamFolderName();

        if (string.IsNullOrEmpty(teamId) || string.IsNullOrEmpty(teamFolderName))
        {
            isLoading = false;
            return;
        }

        var team = teams.FirstOrDefault(t => t.TeamID == teamId);
        currentTeamName = team?.Name ?? "Unknown";

        canCreate = AuthService.HasRole(teamId, "ContentAuthor") || AuthService.IsSystemAdmin();

        try
        {
            presentations = await PresentationService.GetPresentationsForTeamAsync(teamFolderName);

            // Load images asynchronously in background
            _ = LoadImagesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading presentations: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadImagesAsync()
    {
        foreach (var presentation in presentations)
        {
            if (!string.IsNullOrEmpty(presentation.OriginalImagePath))
            {
                try
                {
                    var imageData = await PresentationService.GetImageDataAsync(
                        presentation.TeamFolderName, 
                        presentation.OriginalImagePath);

                    imageCache[presentation.PresentationID] = Convert.ToBase64String(imageData);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading image for {presentation.PresentationID}: {ex.Message}");
                }
            }
        }
    }

    private string GetCreatorName(string userId)
    {
        var currentUser = AuthService.GetCurrentUser();

        if (userId == currentUser?.UserID)
        {
            return "You";
        }

        if (userNames.TryGetValue(userId, out var name))
        {
            return name;
        }

        return "Team Member";
    }

    private string GetImagePreview(Presentation presentation)
    {
        if (imageCache.TryGetValue(presentation.PresentationID, out var base64))
        {
            return base64;
        }
        return string.Empty;
    }

    /*
    private bool CanEdit(Presentation presentation)
    {
        var currentUser = AuthService.GetCurrentUser();
        // return currentUser?.UserID == presentation.CreatedBy || AuthService.IsSystemAdmin();
        return true;
        }
    */

    private void DeletePresentation(Presentation presentation)
    {
        if (CanDeletePresentation(presentation))
        {
            presentationToDelete = presentation;
            showDeleteConfirm = true;
        }
    }

    private async Task ConfirmDelete()
    {
        if (presentationToDelete == null) return;

        try
        {
            await PresentationService.DeletePresentationAsync(
                TeamContext.GetCurrentTeamFolderName()!, 
                presentationToDelete.PresentationID);

            await LoadPresentations();
            showDeleteConfirm = false;
            presentationToDelete = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting presentation: {ex.Message}");
            showDeleteConfirm = false;
        }
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        presentationToDelete = null;
    }

    private async Task LoadUserNames()
    {
        try
        {
            var usersCollection = await UserService.GetAllUsersAsync();
            userNames = usersCollection
                .ToDictionary(u => u.UserID, u => u.DisplayName);
        }
        catch
        {
            // Ignore errors - will fall back to "Team Member"
        }
    }

    private bool CanEditPresentation(Presentation presentation)
    {
        var currentUser = AuthService.GetCurrentUser();

        // SystemAdmin can edit anything
        if (currentUser?.IsSystemAdmin == true)
            return true;

        // Creator can edit their own
        if (presentation.CreatedBy == currentUser?.UserID)
            return true;

        // Role Author can edit
        if (AuthService.HasRole(TeamContext.GetCurrentTeamId()!, "ContentAuthor"))
            return true;

        return false;
    }

    private bool CanDeletePresentation(Presentation presentation)
    {
        return CanEditPresentation(presentation);
    }

}