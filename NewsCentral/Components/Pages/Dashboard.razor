@page "/"
@using NewsCentral.Services
@using NewsCentral.Models
@using NewsCentral.Components.Shared
@using Microsoft.Extensions.Localization
@inject AuthenticationService AuthService
@inject TeamService TeamService
@inject TeamContextService TeamContext
@inject NavigationManager Navigation
@inject IStringLocalizer<Dashboard> Localizer

<PageTitle>@Localizer["Dashboard"] - NewsCentral</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["Welcome"]</h1>
        <p class="page-description">@Localizer["WelcomeSubtitle"]</p>
    </div>

    @* Team selector — the interactive control stays on Home (§ top bar only reflects it) *@
    @if (currentUser != null && availableTeams.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <label class="form-label fw-semibold">@Localizer["CurrentTeam"]</label>
                <select class="form-select" style="max-width: 400px;"
                        @bind="selectedTeamFolderName" @bind:after="OnTeamChanged">
                    @foreach (var team in availableTeams)
                    {
                        <option value="@team.FolderName">@team.Name</option>
                    }
                </select>
            </div>
        </div>
    }
    else if (currentUser != null && !availableTeams.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["NoTeams"]
        </div>
    }

    @* Your profile — the identity the old banner carried, without the dev framing *@
    @if (currentUser != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>@Localizer["YourProfile"]</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@Localizer["DisplayName"]</dt>
                    <dd class="col-sm-9">@currentUser.DisplayName</dd>

                    <dt class="col-sm-3">@Localizer["Email"]</dt>
                    <dd class="col-sm-9">@Display(currentUser.Email)</dd>

                    <dt class="col-sm-3">@Localizer["UPN"]</dt>
                    <dd class="col-sm-9">@Display(currentUser.UPN)</dd>

                    <dt class="col-sm-3">@Localizer["Roles"]</dt>
                    <dd class="col-sm-9">@RenderRoles()</dd>

                    <dt class="col-sm-3">@Localizer["LastLogin"]</dt>
                    <dd class="col-sm-9">@DisplayTime.Local(currentUser.LastLogin, "yyyy-MM-dd HH:mm:ss")</dd>
                </dl>
            </div>
        </div>
    }
</div>

@code {
    private User? currentUser;
    private List<Team> availableTeams = new();
    private string? selectedTeamFolderName;

    protected override async Task OnInitializedAsync()
    {
        currentUser = AuthService.GetCurrentUser();

        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadTeamsAsync();
    }

    private async Task LoadTeamsAsync()
    {
        try
        {
            // SystemAdmin sees ALL teams
            if (currentUser!.IsSystemAdmin)
            {
                availableTeams = await TeamService.GetAllTeamsAsync();
            }
            // Regular users see only their assigned teams
            else if (currentUser.TeamRoles.Any())
            {
                var allTeams = await TeamService.GetAllTeamsAsync();
                var userTeamFolders = currentUser.TeamRoles.Select(tr => tr.TeamFolderName).ToList();
                availableTeams = allTeams.Where(t => userTeamFolders.Contains(t.FolderName)).ToList();
            }
            else
            {
                availableTeams = new List<Team>();
            }

            // Set current selected team
            selectedTeamFolderName = TeamContext.CurrentTeamFolderName;

            // If no team selected, auto-select first available
            if (string.IsNullOrEmpty(selectedTeamFolderName) && availableTeams.Any())
            {
                var firstTeam = availableTeams[0];
                selectedTeamFolderName = firstTeam.FolderName;
                TeamContext.SetCurrentTeam(firstTeam.TeamID, firstTeam.FolderName);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading teams: {ex.Message}");
        }
    }

    private void OnTeamChanged()
    {
        if (!string.IsNullOrEmpty(selectedTeamFolderName))
        {
            var team = availableTeams.FirstOrDefault(t => t.FolderName == selectedTeamFolderName);
            if (team != null)
            {
                TeamContext.SetCurrentTeam(team.TeamID, team.FolderName);
                StateHasChanged();
            }
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private RenderFragment RenderRoles() => __builder =>
    {
        if (currentUser!.IsSystemAdmin)
        {
            <span class="badge bg-primary">@Localizer["SystemAdministrator"]</span>
        }
        else if (currentUser.TeamRoles.Any())
        {
            @foreach (var tr in currentUser.TeamRoles)
            {
                <span class="badge bg-secondary me-1">@tr.TeamFolderName: @string.Join(", ", tr.Roles)</span>
            }
        }
        else
        {
            <span class="text-muted">@Localizer["NoRoles"]</span>
        }
    };
}
