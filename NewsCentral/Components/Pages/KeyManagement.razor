@page "/key-management"
@using NewsCentral.Services
@using NewsCentral.Models
@using NewsCentral.Security
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<KeyManagement> Localizer
@inject IndexGenerationService IndexService
@inject TeamService TeamService
@inject TeamContextService TeamContext
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["PageTitle"]</h1>
        <p class="page-description">@Localizer["PageDescription"]</p>
    </div>

    @if (!hasTeamSelected)
    {
        <div class="alert alert-info">
            @Localizer["NoTeamSelected"]
        </div>
        return;
    }

    @if (!isAuthorized)
    {
        <div class="alert alert-danger">
            <strong>@Localizer["AccessDenied"]</strong>
            <p>@Localizer["AccessDeniedMessage"]</p>
        </div>
        return;
    }

    @* ── Current keys ─────────────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5>@Localizer["CurrentKeysSection"]</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <strong>@Localizer["CurrentTeam"]:</strong> @currentTeamName (@currentTeamFolder)
            </div>

            @if (currentKeys == null ||
                 (string.IsNullOrEmpty(currentKeys.PublicKey) && string.IsNullOrEmpty(currentKeys.PrivateKey)))
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @Localizer["NoKeyConfigured"]
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["CurrentPublicKey"]</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace"
                               readonly value="@currentKeys.PublicKey" />
                        <button class="btn btn-outline-secondary"
                                @onclick="() => CopyToClipboardAsync(currentKeys!.PublicKey!)">
                            <i class="bi bi-clipboard me-1"></i>@Localizer["CopyForGPO"]
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Localizer["CurrentPrivateKey"]</label>
                    <input type="text" class="form-control font-monospace" readonly
                           value="@SigningKeyTool.Truncate(currentKeys.PrivateKey)" />
                    <div class="form-text">@Localizer["PrivateKeyTruncatedHint"]</div>
                </div>

                @if (!string.IsNullOrEmpty(currentKeys.PublicKeyPrevious))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["PreviousPublicKey"]</label>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace"
                                   readonly value="@currentKeys.PublicKeyPrevious" />
                            <button class="btn btn-outline-secondary"
                                    @onclick="() => CopyToClipboardAsync(currentKeys!.PublicKeyPrevious!)">
                                <i class="bi bi-clipboard me-1"></i>@Localizer["CopyForGPO"]
                            </button>
                        </div>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(copyFeedback))
            {
                <div class="alert alert-info py-1 mt-2">
                    <i class="bi bi-check me-1"></i>@copyFeedback
                </div>
            }
        </div>
    </div>

    @* ── Generate / Apply ──────────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5>@Localizer["GenerateSection"]</h5>
        </div>
        <div class="card-body">
            <p>@Localizer["GenerateDescription"]</p>

            <button class="btn btn-secondary" @onclick="GenerateNewKeyPair" disabled="@isBusy">
                <i class="bi bi-plus-circle me-2"></i>@Localizer["GenerateNewKeyPair"]
            </button>

            @if (pendingPublicKey != null)
            {
                <div class="mt-3 p-3 border rounded bg-light">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-warning text-dark me-2">@Localizer["NotYetApplied"]</span>
                        <small class="text-muted">@Localizer["NotYetAppliedHint"]</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["NewPublicKey"]</label>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace"
                                   readonly value="@pendingPublicKey" />
                            <button class="btn btn-outline-secondary"
                                    @onclick="() => CopyToClipboardAsync(pendingPublicKey!)">
                                <i class="bi bi-clipboard me-1"></i>@Localizer["CopyForGPO"]
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["NewPrivateKey"]</label>
                        <input type="text" class="form-control font-monospace" readonly
                               value="@SigningKeyTool.Truncate(pendingPrivateKey)" />
                        <div class="form-text">@Localizer["PrivateKeyTruncatedHint"]</div>
                    </div>

                    <button class="btn btn-primary" @onclick="ApplyNewKeyPairAsync" disabled="@isBusy">
                        @if (isBusy && busyAction == "apply")
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            @Localizer["Applying"]
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-2"></i>
                            @Localizer["Apply"]
                        }
                    </button>
                </div>
            }
        </div>
    </div>

    @* ── Republish ─────────────────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5>@Localizer["RepublishSection"]</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-3">
                <i class="bi bi-info-circle me-2"></i>@Localizer["RepublishReminder"]
            </div>

            <button class="btn btn-warning" @onclick="RepublishIndexAsync" disabled="@isBusy">
                @if (isBusy && busyAction == "republish")
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    @Localizer["Republishing"]
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-2"></i>
                    @Localizer["RepublishIndex"]
                }
            </button>
        </div>
    </div>

    @* ── Feedback alerts ──────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* M5a: distinct from errorMessage — the index itself republished fine, only distribution failed. TODO(i18n). *@
    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @warningMessage
            <button type="button" class="btn-close" @onclick="() => warningMessage = null"></button>
        </div>
    }
</div>

@code {
    private bool hasTeamSelected;
    private bool isAuthorized;
    private string? currentTeamFolder;
    private string? currentTeamName;
    private TeamSigningKeys? currentKeys;
    private string? pendingPrivateKey;
    private string? pendingPublicKey;
    private bool isBusy;
    private string? busyAction;
    private string? copyFeedback;
    private string? successMessage;
    private string? errorMessage;
    private string? warningMessage;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = AuthService.GetCurrentUser();
        if (currentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        hasTeamSelected = TeamContext.HasTeamSelected();
        if (!hasTeamSelected) return;

        isAuthorized = AuthService.HasRole(TeamContext.GetCurrentTeamId()!, "TeamAdmin");
        if (!isAuthorized) return;

        currentTeamFolder = TeamContext.GetCurrentTeamFolderName()!;
        var team = await TeamService.GetTeamByFolderNameAsync(currentTeamFolder);
        currentTeamName = team?.Name ?? currentTeamFolder;

        await LoadCurrentKeysAsync();
    }

    private async Task LoadCurrentKeysAsync()
    {
        try
        {
            currentKeys = await IndexService.LoadTeamSigningKeysAsync(currentTeamFolder!);
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["LoadError"]}: {ex.Message}";
        }
    }

    private void GenerateNewKeyPair()
    {
        var (priv, pub) = SigningKeyTool.GenerateKeyPair();
        pendingPrivateKey = priv;
        pendingPublicKey  = pub;
        successMessage    = null;
        errorMessage      = null;
    }

    private async Task ApplyNewKeyPairAsync()
    {
        if (pendingPrivateKey == null || pendingPublicKey == null || isBusy) return;

        try
        {
            isBusy     = true;
            busyAction = "apply";
            successMessage = null;
            errorMessage   = null;
            StateHasChanged();

            var newKeys = new TeamSigningKeys
            {
                PrivateKey        = pendingPrivateKey,
                PublicKey         = pendingPublicKey,
                PublicKeyPrevious = currentKeys?.PublicKey
            };

            await IndexService.SaveTeamSigningKeysAsync(currentTeamFolder!, newKeys);

            pendingPrivateKey = null;
            pendingPublicKey  = null;

            await LoadCurrentKeysAsync();

            successMessage = $"{Localizer["ApplySuccess"]} — {Localizer["RotationReminder"]}";
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["ApplyError"]}: {ex.Message}";
        }
        finally
        {
            isBusy     = false;
            busyAction = null;
            StateHasChanged();
        }
    }

    private async Task RepublishIndexAsync()
    {
        if (isBusy) return;

        try
        {
            isBusy     = true;
            busyAction = "republish";
            successMessage = null;
            errorMessage   = null;
            warningMessage = null;
            StateHasChanged();

            var result = await IndexService.GenerateAndSaveIndexAsync(currentTeamFolder!);

            if (result.DistributionSucceeded)
            {
                successMessage = Localizer["RepublishSuccess", currentTeamName ?? currentTeamFolder!];
            }
            else
            {
                warningMessage =
                    $"Republished the index for {currentTeamName ?? currentTeamFolder!}, but distribution failed: " +
                    $"{result.DistributionError?.TrimEnd('.')}. Clients will not receive it until this is resolved and republished again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Localizer["RepublishError"]}: {ex.Message}";
        }
        finally
        {
            isBusy     = false;
            busyAction = null;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copyFeedback = Localizer["Copied"];
        }
        catch
        {
            copyFeedback = Localizer["CopyFailed"];
        }

        StateHasChanged();
        await Task.Delay(2000);
        copyFeedback = null;
        StateHasChanged();
    }
}
