    }

    .status-badge.pending {
        background: #fff3cd;
        color: #856404;
    }

    .approval-body {
        margin-bottom: 20px;
    }

    .description {
        color: #666;
        margin-bottom: 15px;
    }

    .schedule-info {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 5px;
