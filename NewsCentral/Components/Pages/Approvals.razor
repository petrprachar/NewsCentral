        font-size: 14px;
        color: #333;
    }

    .poster-preview {
        margin-top: 15px;
        text-align: center;
        background: #000;
        padding: 10px;
        border-radius: 5px;
    }

    .poster-preview img {
        max-width: 100%;
        max-height: 300px;
        border-radius: 5px;
    }

    .approval-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
