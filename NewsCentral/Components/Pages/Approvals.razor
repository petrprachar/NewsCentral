        text-align: center;
        padding: 40px;
        color: #666;
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .empty-state h3 {
        color: #666;
        margin-bottom: 10px;
    }

