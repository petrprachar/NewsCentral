@page "/approvals"
@using Microsoft.Extensions.Localization
@inject Services.AssignmentService AssignmentService
@inject Services.PresentationService PresentationService
@inject Services.ScheduleService ScheduleService
@inject Services.TeamService TeamService
@inject Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<Approvals> Localizer
@using NewsCentral.Components.Shared
@using NewsCentral.Models
@using NewsCentral.Ui

<PageTitle>@Localizer["PageTitle"] - NewsCentral</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["PageTitle"]</h1>
        <p class="subtitle">@Localizer["Subtitle"]</p>
    </div>

    @if (isLoading)
    {
        <div class="loading">@Localizer["Loading"]</div>
    }
    else
    {
        @* UI-2 — bulk run progress/summary, shown above the list so it stays visible even once a
           successful run has emptied the list below (e.g. rejecting every pending item). *@
        <BulkRunPanel Running="isRunning" Done="runDone" Total="runTotal" Verb="@runVerb"
                      Result="runResult" OnStop="StopRun" />

        @if (!string.IsNullOrEmpty(errorMessage) && !showRejectDialog)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (batchViewModels.Count == 0)
        {
            <div class="empty-state">
                <h3>@Localizer["NoPendingApprovals"]</h3>
                <p>@Localizer["NoAssignmentsMessage"]</p>
            </div>
        }
        else
        {
            <div class="approvals-toolbar">
                <input type="text" class="approvals-search" placeholder="@Localizer["SearchPlaceholder"]"
                       @bind="approvalSearch" @bind:event="oninput" disabled="@isRunning" />
                <TriStateCheckbox State="@selection.StateOf(AllShownAssignments.Select(a => a.AssignmentID))"
                                  OnToggle="@(() => selection.ToggleAll(AllShownAssignments.Select(a => a.AssignmentID)))"
                                  Disabled="@isRunning"
                                  Label="@(IsSearchActive
                                      ? string.Format(Localizer["SelectAllShownLabel"].Value, AllShownAssignments.Count)
                                      : string.Format(Localizer["SelectAllLabel"].Value, AllPendingAssignments.Count))" />
                <span class="approvals-counter">
                    @string.Format(Localizer["SelectedCounter"].Value, selection.Count, AllPendingAssignments.Count)
                </span>
                <div class="approvals-bulk-actions">
                    <button class="btn btn-danger" @onclick="ShowRejectDialogForSelection" disabled="@(selection.Count == 0 || isRunning)">
                        @string.Format(Localizer["RejectCount"].Value, selection.Count)
                    </button>
                    <button class="btn btn-success" @onclick="@(() => showApproveConfirm = true)" disabled="@(selection.Count == 0 || isRunning)">
                        @string.Format(Localizer["ApproveCount"].Value, selection.Count)
                    </button>
                </div>
            </div>

            var shownBatches = batchViewModels.Where(b => ShownInBatch(b).Count > 0).ToList();

            @if (shownBatches.Count == 0)
            {
                <p class="no-batches-match">@string.Format(Localizer["NoAssignmentsMatchSearch"].Value, approvalSearch)</p>
            }
            else
            {
                <div class="batches-list">
                    @foreach (var vm in shownBatches)
                    {
                        var shownInBatch = ShownInBatch(vm);

                        <div class="batch-card">
                            <div class="batch-header">
                                <TriStateCheckbox State="@selection.StateOf(shownInBatch.Select(a => a.AssignmentID))"
                                                  OnToggle="@(() => selection.ToggleAll(shownInBatch.Select(a => a.AssignmentID)))"
                                                  Disabled="@isRunning" />
                                <button type="button" class="batch-expand-toggle" @onclick="@(() => vm.IsExpanded = !vm.IsExpanded)">
                                    <i class="bi @(vm.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </button>
                                <div class="batch-header-main">
                                    <div class="batch-title">@vm.PresentationTitle</div>
                                    <div class="batch-meta">
                                        @Localizer["ScheduleLabel"]
                                        @(vm.ScheduleStart.HasValue && vm.ScheduleEnd.HasValue
                                            ? $"{vm.ScheduleStart.Value:MMM dd, yyyy} - {vm.ScheduleEnd.Value:MMM dd, yyyy}"
                                            : "—")
                                        &nbsp;·&nbsp; @Localizer["From"] <strong>@vm.SourceTeamName</strong>
                                        &nbsp;·&nbsp; @string.Format(Localizer["TeamsCountLabel"].Value, vm.Batch.Count)
                                        &nbsp;·&nbsp; @DisplayTime.Local(vm.Batch.CreatedUtc, "yyyy-MM-dd HH:mm")
                                    </div>
                                </div>
                            </div>

                            @if (vm.IsExpanded)
                            {
                                <div class="batch-rows">
                                    @foreach (var assignment in shownInBatch)
                                    {
                                        var isSelected = selection.IsSelected(assignment.AssignmentID);

                                        <div class="batch-row @(isSelected ? "selected" : "")">
                                            <label class="batch-row-main">
                                                <input type="checkbox" checked="@isSelected" disabled="@isRunning"
                                                       @onchange="@(e => selection.Set(assignment.AssignmentID, (bool)e.Value!))" />
                                                <span>@TeamDisplayName(assignment.TargetTeam)</span>
                                            </label>
                                            <div class="batch-row-actions">
                                                <button class="btn btn-sm btn-danger" disabled="@isRunning"
                                                        @onclick="@(() => ShowRejectDialogForItem(assignment))">
                                                    @Localizer["Reject"]
                                                </button>
                                                <button class="btn btn-sm btn-success" disabled="@isRunning"
                                                        @onclick="@(() => ApproveSingleAsync(assignment))">
                                                    @Localizer["Approve"]
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>

<ConfirmDialog IsVisible="showApproveConfirm"
               Title="@Localizer["BulkApproveConfirmTitle"]"
               Message="@string.Format(Localizer["BulkApproveConfirmMessage"].Value, selection.Count)"
               ConfirmText="@Localizer["Approve"]"
               CancelText="@Localizer["Cancel"]"
               DialogType="warning"
               OnConfirm="ConfirmBulkApprove"
               OnCancel="@(() => showApproveConfirm = false)" />

@if (showRejectDialog)
{
    <div class="modal-overlay" @onclick="CloseRejectDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h2>@string.Format(Localizer["RejectAssignmentTitle"].Value, rejectingItems?.Count ?? 0)</h2>

            <div class="form-group">
                <label>@Localizer["RejectionReasonLabel"]</label>
                <textarea @bind="rejectionReason" class="form-control" rows="3"
                          placeholder="@Localizer["RejectionReasonPlaceholder"]"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="modal-actions">
                <button @onclick="CloseRejectDialog" class="btn btn-secondary">@Localizer["Cancel"]</button>
                <button @onclick="ConfirmReject" class="btn btn-danger" disabled="@isRunning">
                    @(isRunning ? Localizer["Rejecting"].Value : Localizer["RejectButton"].Value)
                </button>
            </div>
        </div>
    </div>
}

