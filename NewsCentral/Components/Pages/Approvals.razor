        align-items: start;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f0f0;
    }

    .approval-header h3 {
        margin: 0;
        color: #333;
    }

    .meta {
        color: #666;
        margin: 5px 0 0 0;
        font-size: 14px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 5px;
