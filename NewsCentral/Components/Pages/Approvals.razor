@page "/approvals"
@using Microsoft.Extensions.Localization
@inject Services.AssignmentService AssignmentService
@inject Services.PresentationService PresentationService
@inject Services.ScheduleService ScheduleService
@inject Services.TeamService TeamService
@inject Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<Approvals> Localizer
@using NewsCentral.Components.Shared
@using NewsCentral.Models

<PageTitle>@Localizer["PageTitle"] - NewsCentral</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["PageTitle"]</h1>
        <p class="subtitle">@Localizer["Subtitle"]</p>
    </div>

    @if (isLoading)
    {
        <div class="loading">@Localizer["Loading"]</div>
    }
    else if (pendingApprovals.Count == 0)
    {
        <div class="empty-state">
            <h3>@Localizer["NoPendingApprovals"]</h3>
            <p>@Localizer["NoAssignmentsMessage"]</p>
        </div>
    }
    else
    {
        <div class="approvals-list">
            @foreach (var approval in pendingApprovals)
            {
                <div class="approval-card">
                    <div class="approval-header">
                        <div>
                            <h3>@approval.PresentationName</h3>

                            <!-- NEW: Display type badges -->
                            @if (approval.Presentation != null && (approval.Presentation.IsNewsOfWeek || approval.Presentation.IsWallpaper || approval.Presentation.IsLogonScreen))
                            {
                                <div class="display-badges-inline">
                                    <DisplayTypeBadges ShowNewsOfWeek="@approval.Presentation.IsNewsOfWeek"
                                                       ShowWallpaper="@approval.Presentation.IsWallpaper"
                                                       ShowLogonScreen="@approval.Presentation.IsLogonScreen" />
                                </div>
                            }

                            <p class="meta">
                                @Localizer["From"]: <strong>@approval.SourceTeamName</strong>
                                → @Localizer["To"]: <strong>@approval.TargetTeamName</strong>
                            </p>
                        </div>
                        <div class="status-badge pending">
                            @Localizer["PendingApprovalBadge"]
                        </div>
                    </div>

                    <div class="approval-body">
                        <p class="description"><strong>@Localizer["CommentLabel"]</strong> @approval.PresentationDescription</p>

                        <div class="schedule-info">
                            <strong>@Localizer["ScheduleLabel"]</strong><br/>
                            @approval.ScheduleStart.ToString("MMM dd, yyyy") - @approval.ScheduleEnd.ToString("MMM dd, yyyy")<br/>
                            @Localizer["DaysLabel"]: @FormatDaysOfWeek(approval.DaysOfWeek)
                        </div>

                        @if (!string.IsNullOrEmpty(approval.PosterPreview))
                        {
                            <div class="poster-preview">
                                <img src="@approval.PosterPreview" alt="Poster preview" />
                            </div>
                        }
                    </div>

                    <div class="approval-actions">
                        <button @onclick="() => ShowRejectDialog(approval)" class="btn btn-danger">
                            @Localizer["Reject"]
                        </button>
                        <button @onclick="() => ApproveAssignment(approval)" class="btn btn-success">
                            @Localizer["Approve"]
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showRejectDialog)
{
    <div class="modal-overlay" @onclick="CloseRejectDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h2>@Localizer["RejectAssignmentTitle"]</h2>

            <p>@Localizer["RejectConfirmQuestion"]</p>
            <p><strong>@rejectingApproval?.PresentationName</strong></p>

            <div class="form-group">
                <label>@Localizer["RejectionReasonLabel"]</label>
                <textarea @bind="rejectionReason" class="form-control" rows="3"
                          placeholder="@Localizer["RejectionReasonPlaceholder"]"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="modal-actions">
                <button @onclick="CloseRejectDialog" class="btn btn-secondary">@Localizer["Cancel"]</button>
                <button @onclick="ConfirmReject" class="btn btn-danger" disabled="@isProcessing">
                    @(isProcessing ? Localizer["Rejecting"].Value : Localizer["RejectButton"].Value)
                </button>
            </div>
        </div>
    </div>
}

