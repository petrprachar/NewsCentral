</style>

@code {
    private List<ApprovalViewModel> pendingApprovals = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showRejectDialog = false;
    private ApprovalViewModel? rejectingApproval;
    private string rejectionReason = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPendingApprovals();
    }

    private async Task LoadPendingApprovals()
    {
        isLoading = true;
        pendingApprovals.Clear();

        try
        {
            var assignments = await AssignmentService.GetPendingApprovalsForUserAsync();
            var allTeams = await TeamService.GetAllTeamsAsync();

            foreach (var assignment in assignments)
            {
                // Load presentation details
                var presentation = await PresentationService.GetPresentationAsync(
                    assignment.SourceTeam,
                    assignment.PresentationID);

                if (presentation is null) continue;

                var sourceTeam = allTeams.FirstOrDefault(t => t.FolderName == assignment.SourceTeam);
                var targetTeam = allTeams.FirstOrDefault(t => t.FolderName == assignment.TargetTeam);

                // Load poster preview
                string? posterPreview = null;
                if (!string.IsNullOrEmpty(presentation.ContentImageBase64))
                {
                    posterPreview = $"data:image/jpeg;base64,{presentation.ContentImageBase64}";
                }

                // Load schedule
                var schedule = await ScheduleService.GetScheduleAsync(
                    assignment.SourceTeam,
                    assignment.ScheduleID);

                pendingApprovals.Add(new ApprovalViewModel
                {
                    Assignment = assignment,
                    PresentationName = presentation.Name,
                    PresentationDescription = presentation.Description,
                    SourceTeamName = sourceTeam?.Name ?? assignment.SourceTeam,
                    TargetTeamName = targetTeam?.Name ?? assignment.TargetTeam,
                    PosterPreview = posterPreview,
                    ScheduleStart = schedule?.ScheduleStart ?? DateTime.MinValue,
                    ScheduleEnd = schedule?.ScheduleEnd ?? DateTime.MaxValue,
                    DaysOfWeek = schedule?.DaysOfWeek ?? "",
                    Presentation = presentation  // Store presentation reference
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approvals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveAssignment(ApprovalViewModel approval)
    {
        try
        {
            await AssignmentService.ApproveAssignmentAsync(
                approval.Assignment.SourceTeam,
                approval.Assignment.AssignmentID,
                "Approved via UI"
            );

            // Remove from list
            pendingApprovals.Remove(approval);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving assignment: {ex.Message}";
        }
    }

    private void ShowRejectDialog(ApprovalViewModel approval)
    {
        rejectingApproval = approval;
        rejectionReason = string.Empty;
        errorMessage = string.Empty;
        showRejectDialog = true;
    }

    private void CloseRejectDialog()
    {
        showRejectDialog = false;
        rejectingApproval = null;
        rejectionReason = string.Empty;
        errorMessage = string.Empty;
    }

    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectionReason))
        {
            errorMessage = Localizer["ReasonRequired"];
            return;
        }

        if (rejectingApproval is null) return;

        isProcessing = true;

        try
        {
            await AssignmentService.RejectAssignmentAsync(
                rejectingApproval.Assignment.SourceTeam,
                rejectingApproval.Assignment.AssignmentID,
                rejectionReason
            );

            // Remove from list
            pendingApprovals.Remove(rejectingApproval);
            CloseRejectDialog();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error rejecting assignment: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string FormatDaysOfWeek(string daysOfWeek)
    {
        if (string.IsNullOrEmpty(daysOfWeek)) return Localizer["None"];

        var days = daysOfWeek.Split(',').Select(int.Parse).ToList();
        var dayNames = new List<string>();

        foreach (var day in days)
        {
            dayNames.Add(day switch
            {
                1 => Localizer["Mon"],
                2 => Localizer["Tue"],
                3 => Localizer["Wed"],
                4 => Localizer["Thu"],
                5 => Localizer["Fri"],
                6 => Localizer["Sat"],
                7 => Localizer["Sun"],
                _ => ""
            });
        }

        return string.Join(", ", dayNames);
    }

    private class ApprovalViewModel
    {
        public Assignment Assignment { get; set; } = null!;
        public string PresentationName { get; set; } = string.Empty;
        public string PresentationDescription { get; set; } = string.Empty;
        public string SourceTeamName { get; set; } = string.Empty;
        public string TargetTeamName { get; set; } = string.Empty;
        public string? PosterPreview { get; set; }
        public DateTime ScheduleStart { get; set; }
        public DateTime ScheduleEnd { get; set; }
        public string DaysOfWeek { get; set; } = string.Empty;
        public Presentation? Presentation { get; set; }
    }
}
