@code {
    private List<BatchViewModel> batchViewModels = new();
    private Dictionary<string, string> teamNamesByFolder = new(StringComparer.OrdinalIgnoreCase);
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    // UI-2 — selection/search over the flattened set of pending assignments, keyed by AssignmentID.
    private SelectionModel<string> selection = new();
    private string approvalSearch = string.Empty;

    private bool showApproveConfirm;
    private bool showRejectDialog;
    private List<Assignment>? rejectingItems;
    private string rejectionReason = string.Empty;

    private bool isRunning;
    private string runVerb = string.Empty;
    private int runDone;
    private int runTotal;
    private BulkRunResult<Assignment>? runResult;
    private CancellationTokenSource? runCts;

    private bool IsSearchActive => !string.IsNullOrWhiteSpace(approvalSearch);

    private List<Assignment> AllPendingAssignments => batchViewModels.SelectMany(b => b.Batch.Assignments).ToList();

    private List<Assignment> AllShownAssignments => batchViewModels.SelectMany(ShownInBatch).ToList();

    private string TeamDisplayName(string folderName) =>
        teamNamesByFolder.TryGetValue(folderName, out var name) ? name : folderName;

    private bool MatchesSearch(string? text) =>
        !IsSearchActive || (text != null && text.Contains(approvalSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    // A batch whose presentation title matches shows every one of its rows (the title is shared
    // by the whole batch); otherwise each row is matched individually against its target team.
    private List<Assignment> ShownInBatch(BatchViewModel vm)
    {
        if (!IsSearchActive || MatchesSearch(vm.PresentationTitle))
            return vm.Batch.Assignments.ToList();

        return vm.Batch.Assignments
            .Where(a => MatchesSearch(TeamDisplayName(a.TargetTeam)) || MatchesSearch(a.TargetTeam))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPendingApprovals();
    }

    // Looks up each batch's presentation and schedule ONCE (not per row) — every assignment in a
    // batch shares the same SourceTeam + PresentationID + ScheduleID, so one lookup covers it.
    private async Task LoadPendingApprovals()
    {
        isLoading = true;

        try
        {
            var assignments = await AssignmentService.GetPendingApprovalsForUserAsync();
            var allTeams = await TeamService.GetAllTeamsAsync();
            teamNamesByFolder = allTeams.ToDictionary(t => t.FolderName, t => t.Name, StringComparer.OrdinalIgnoreCase);

            var batches = AssignmentBatchGrouper.Group(assignments);
            var previousExpansion = batchViewModels.ToDictionary(b => b.Batch.Key, b => b.IsExpanded);

            var newViewModels = new List<BatchViewModel>();
            foreach (var batch in batches)
            {
                var presentation = await PresentationService.GetPresentationAsync(batch.Key.SourceTeam, batch.Key.PresentationID);
                var schedule = string.IsNullOrEmpty(batch.Key.ScheduleID)
                    ? null
                    : await ScheduleService.GetScheduleAsync(batch.Key.SourceTeam, batch.Key.ScheduleID);
                var sourceTeam = allTeams.FirstOrDefault(t => t.FolderName == batch.Key.SourceTeam);

                newViewModels.Add(new BatchViewModel
                {
                    Batch = batch,
                    PresentationTitle = presentation?.Name ?? batch.Key.PresentationID,
                    ScheduleStart = schedule?.ScheduleStart,
                    ScheduleEnd = schedule?.ScheduleEnd,
                    SourceTeamName = sourceTeam?.Name ?? batch.Key.SourceTeam,
                    // Batches with more than 5 items start collapsed; 5 or fewer start expanded —
                    // unless the batch already existed before this reload, in which case its
                    // expand/collapse state is preserved instead.
                    IsExpanded = previousExpansion.TryGetValue(batch.Key, out var wasExpanded)
                        ? wasExpanded
                        : batch.Count <= 5
                });
            }

            batchViewModels = newViewModels;
            selection.RemoveMissing(assignments.Select(a => a.AssignmentID));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading approvals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveSingleAsync(Assignment assignment)
    {
        errorMessage = string.Empty;
        try
        {
            await AssignmentService.ApproveAssignmentAsync(
                assignment.SourceTeam, assignment.AssignmentID, "Approved via UI");
            await LoadPendingApprovals();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving assignment: {ex.Message}";
        }
    }

    private void ShowRejectDialogForItem(Assignment assignment)
    {
        rejectingItems = new List<Assignment> { assignment };
        rejectionReason = string.Empty;
        errorMessage = string.Empty;
        showRejectDialog = true;
    }

    private void ShowRejectDialogForSelection()
    {
        if (selection.Count == 0) return;

        rejectingItems = AllPendingAssignments.Where(a => selection.IsSelected(a.AssignmentID)).ToList();
        rejectionReason = string.Empty;
        errorMessage = string.Empty;
        showRejectDialog = true;
    }

    private void CloseRejectDialog()
    {
        showRejectDialog = false;
        rejectingItems = null;
        rejectionReason = string.Empty;
        errorMessage = string.Empty;
    }

    private async Task ConfirmBulkApprove()
    {
        showApproveConfirm = false;
        var items = AllPendingAssignments.Where(a => selection.IsSelected(a.AssignmentID)).ToList();
        await RunBulkAsync(items, "Approving",
            a => AssignmentService.ApproveAssignmentAsync(a.SourceTeam, a.AssignmentID, "Approved via bulk action"));
    }

    // Single-item reject keeps working through this SAME dialog — a run of exactly one item.
    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectionReason))
        {
            errorMessage = Localizer["ReasonRequired"];
            return;
        }

        if (rejectingItems == null || rejectingItems.Count == 0)
            return;

        showRejectDialog = false;
        var items = rejectingItems;
        var reason = rejectionReason;
        rejectingItems = null;

        await RunBulkAsync(items, "Rejecting",
            a => AssignmentService.RejectAssignmentAsync(a.SourceTeam, a.AssignmentID, reason));
    }

    private async Task RunBulkAsync(List<Assignment> items, string verb, Func<Assignment, Task> action)
    {
        isRunning = true;
        runVerb = verb;
        runDone = 0;
        runTotal = items.Count;
        runResult = null;
        runCts = new CancellationTokenSource();
        StateHasChanged();

        var progress = new Progress<(int done, int total)>(p =>
        {
            runDone = p.done;
            runTotal = p.total;
            InvokeAsync(StateHasChanged);
        });

        var result = await BulkOperationRunner.RunAsync(
            items,
            async item =>
            {
                await action(item);
                return BulkItemOutcome.Success();
            },
            progress,
            runCts.Token);

        isRunning = false;
        runResult = result;
        runCts.Dispose();
        runCts = null;

        await LoadPendingApprovals();
        StateHasChanged();
    }

    private void StopRun() => runCts?.Cancel();

    private sealed class BatchViewModel
    {
        public AssignmentBatch Batch { get; set; } = null!;
        public string PresentationTitle { get; set; } = string.Empty;
        public DateTime? ScheduleStart { get; set; }
        public DateTime? ScheduleEnd { get; set; }
        public string SourceTeamName { get; set; } = string.Empty;
        public bool IsExpanded { get; set; }
    }
}
