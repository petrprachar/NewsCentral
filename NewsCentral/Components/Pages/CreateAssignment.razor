@code
{
    [Parameter] public string PresentationId { get; set; } = string.Empty;

    private Presentation? presentation;
    private List<Team> availableTeams = new();
    private bool isLoading = true;
    private bool isCreating = false;

    private DateTime scheduleStartDate = DateTime.Today;
    private DateTime scheduleEndDate = DateTime.Today.AddDays(30);
    private bool monday = true;
    private bool tuesday = true;
    private bool wednesday = true;
    private bool thursday = true;
    private bool friday = true;
    private bool saturday = true;
    private bool sunday = true;

    private Team? currentTeam;

    private List<string> selectedTeams = new();
    private bool requiresApproval = true;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    // UI-1 — Other Teams selector: search/toggle affect only what is SHOWN, never what is
    // selected; selectedTeams (above) remains the single source of truth.
    private string teamSearch = string.Empty;
    private bool showSelectedOnly;
    private ElementReference masterCheckboxRef;

    private int OtherSelectedCount => availableTeams.Count(t => selectedTeams.Contains(t.TeamID));

    private bool IsOtherTeamsFilterActive => showSelectedOnly || !string.IsNullOrWhiteSpace(teamSearch);

    private string CreateButtonLabel => selectedTeams.Count == 1
        ? string.Format(Localizer["CreateAssignmentsSingular"].Value, selectedTeams.Count)
        : string.Format(Localizer["CreateAssignmentsPlural"].Value, selectedTeams.Count);

    // Recomputed on every access (markup + OnAfterRenderAsync) — up to ~200 teams, trivial cost
    // per keystroke; no caching needed.
    private List<Team> ShownOtherTeams
    {
        get
        {
            IEnumerable<Team> query = availableTeams;

            if (showSelectedOnly)
                query = query.Where(t => selectedTeams.Contains(t.TeamID));

            if (!string.IsNullOrWhiteSpace(teamSearch))
            {
                var s = teamSearch.Trim();
                query = query.Where(t =>
                    (t.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.FolderName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query.OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private bool MasterChecked(List<Team> shown) =>
        shown.Count > 0 && shown.All(t => selectedTeams.Contains(t.TeamID));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!TeamContext.HasTeamSelected())
        {
            Navigation.NavigateTo("/presentations");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var teamFolderName = TeamContext.GetCurrentTeamFolderName();
            if (string.IsNullOrEmpty(teamFolderName))
            {
                Navigation.NavigateTo("/presentations");
                return;
            }

            presentation = await PresentationService.GetPresentationAsync(teamFolderName, PresentationId);

            if (presentation is null)
            {
                return;
            }

            // Get current user
            var currentUser = AuthService.GetCurrentUser();
            if (currentUser is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Load all teams
            var allTeams = await TeamService.GetAllTeamsAsync();
            currentTeam = allTeams.FirstOrDefault(t => t.FolderName == teamFolderName);

            // Filter "Other Teams" based on user permissions
            if (currentUser.IsSystemAdmin)
            {
                // System admins can publish to any team
                availableTeams = allTeams
                    .Where(t => t.FolderName != teamFolderName)
                    .ToList();

                Console.WriteLine("User is SystemAdmin - showing all teams");
            }
            else
            {
                // Regular users: only show teams where they have "ContentAuthor" role
                var contentAuthorTeamFolders = currentUser.TeamRoles
                    .Where(tr => tr.Roles.Contains("ContentAuthor"))  // ← Check if "ContentAuthor" is in the Roles list
                    .Select(tr => tr.TeamFolderName)
                    .ToHashSet();

                availableTeams = allTeams
                    .Where(t => t.FolderName != teamFolderName)  // Exclude current team
                    .Where(t => contentAuthorTeamFolders.Contains(t.FolderName))  // User has ContentAuthor role
                    .ToList();

                Console.WriteLine($"User has ContentAuthor in: {string.Join(", ", contentAuthorTeamFolders)}");
            }

            Console.WriteLine($"=== CreateAssignment - LoadData ===");
            Console.WriteLine($"Current team: {teamFolderName}");
            Console.WriteLine($"User: {currentUser.Username}");
            Console.WriteLine($"Is SystemAdmin: {currentUser.IsSystemAdmin}");
            Console.WriteLine($"Available other teams: {availableTeams.Count}");
            foreach (var team in availableTeams)
            {
                Console.WriteLine($"  - {team.Name} ({team.FolderName})");
            }

            // Auto-select current team by default
            selectedTeams.Clear();
            if (currentTeam != null)
            {
                selectedTeams.Add(currentTeam.TeamID);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"ERROR in LoadData: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleTeam(string teamId, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedTeams.Contains(teamId))
            {
                selectedTeams.Add(teamId);
            }
        }
        else
        {
            selectedTeams.Remove(teamId);
        }
    }

    // From unchecked or indeterminate (not every shown row selected): select all shown. From
    // checked (every shown row already selected): deselect all shown. Rows hidden by the filter
    // keep whatever selection they already had.
    private void ToggleMaster(List<Team> shown)
    {
        var allSelected = MasterChecked(shown);
        foreach (var team in shown)
        {
            if (allSelected)
                selectedTeams.Remove(team.TeamID);
            else if (!selectedTeams.Contains(team.TeamID))
                selectedTeams.Add(team.TeamID);
        }
    }

    private void ClearAllOtherTeams()
    {
        foreach (var team in availableTeams)
            selectedTeams.Remove(team.TeamID);
    }

    // The DOM `indeterminate` property has no HTML attribute equivalent, so it cannot be set from
    // markup — set via a tiny JS interop call (wwwroot/js/team-selection.js) after every render
    // instead, reflecting the CURRENT shown/selected state each time.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (availableTeams.Count == 0)
            return;

        try
        {
            var shown = ShownOtherTeams;
            var selectedShown = shown.Count(t => selectedTeams.Contains(t.TeamID));
            var isIndeterminate = shown.Count > 0 && selectedShown > 0 && selectedShown < shown.Count;
            await JS.InvokeVoidAsync("ncSetIndeterminate", masterCheckboxRef, isIndeterminate);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[CreateAssignment] Failed to set master checkbox indeterminate state: {ex.Message}");
        }
    }

    private async Task CreateAssignments()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Validation
        if (scheduleEndDate <= scheduleStartDate)
        {
            errorMessage = Localizer["EndDateAfterStart"];
            return;
        }

        var selectedDays = GetSelectedDays();
        if (selectedDays.Count == 0)
        {
            errorMessage = Localizer["SelectDayOfWeek"];
            return;
        }

        if (selectedTeams.Count == 0)
        {
            errorMessage = Localizer["SelectTargetTeam"];
            return;
        }

        isCreating = true;

        try
        {
            var teamFolderName = TeamContext.GetCurrentTeamFolderName();
            if (string.IsNullOrEmpty(teamFolderName))
            {
                errorMessage = Localizer["NoTeamSelected"];
                return;
            }

            if (presentation is null)
            {
                errorMessage = Localizer["PresentationNotLoaded"];
                return;
            }

            // Create schedule
            var schedule = await ScheduleService.CreateScheduleAsync(
                teamFolderName,
                PresentationId,
                presentation.Version.ToString(),
                scheduleStartDate,
                scheduleEndDate,
                selectedDays
            );

            // Create assignments for each selected team
            var allTeams = await TeamService.GetAllTeamsAsync();
            var createdCount = 0;

            foreach (var teamId in selectedTeams)
            {
                var targetTeam = allTeams.FirstOrDefault(t => t.TeamID == teamId);
                if (targetTeam is null) continue;

                await AssignmentService.CreateAssignmentAsync(
                    teamFolderName,
                    PresentationId,
                    presentation.Version.ToString(),
                    schedule.ScheduleID,
                    targetTeam.FolderName,
                    requiresApproval
                );

                createdCount++;
            }

            successMessage = string.Format(Localizer["AssignmentsCreated"].Value, createdCount);

            if (requiresApproval)
            {
                successMessage += " " + Localizer["PendingApprovalSuffix"];
            }
            else
            {
                successMessage += " " + Localizer["AutoApprovedSuffix"];
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating assignments: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private List<int> GetSelectedDays()
    {
        var days = new List<int>();
        if (monday) days.Add(1);
        if (tuesday) days.Add(2);
        if (wednesday) days.Add(3);
        if (thursday) days.Add(4);
        if (friday) days.Add(5);
        if (saturday) days.Add(6);
        if (sunday) days.Add(7);
        return days;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/presentations");
    }

    private void ReturnToPresentations()
    {
        Navigation.NavigateTo("/presentations");
    }

}
