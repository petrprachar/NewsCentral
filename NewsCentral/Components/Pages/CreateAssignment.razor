@page "/presentations/{presentationId}/assign"
@using Microsoft.Extensions.Localization
@using NewsCentral.Models
@using NewsCentral.Components.Shared
@inject Services.PresentationService PresentationService
@inject Services.ScheduleService ScheduleService
@inject Services.AssignmentService AssignmentService
@inject Services.TeamService TeamService
@inject Services.TeamContextService TeamContext
@inject Services.AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<CreateAssignment> Localizer
@inject IJSRuntime JS

<PageTitle>@Localizer["PageTitle"] - NewsCentral</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>@Localizer["PageTitle"]</h1>
    </div>

    @if (isLoading)
    {
        <div class="loading">@Localizer["Loading"]</div>
    }
    else if (presentation == null)
    {
        <div class="alert alert-danger">
            <p>@Localizer["PresentationNotFound"]</p>
            <a href="/presentations" class="btn btn-secondary">@Localizer["BackToPresentations"]</a>
        </div>
    }
    else
    {
        <div class="assign-form">
            <div class="form-section">
                <h3>@Localizer["PresentationSection"]</h3>
                <div class="presentation-info">
                    <strong>@presentation.Name</strong>
                    <p>@presentation.Description</p>

                    @if (presentation.IsNewsOfWeek || presentation.IsWallpaper || presentation.IsLogonScreen)
                    {
                        <div class="display-badges-container">
                            <DisplayTypeBadges ShowNewsOfWeek="@presentation.IsNewsOfWeek"
                                               ShowWallpaper="@presentation.IsWallpaper"
                                               ShowLogonScreen="@presentation.IsLogonScreen" />
                        </div>
                    }
                </div>
            </div>

            <div class="form-section">
                <h3>@Localizer["ScheduleSection"]</h3>

                <div class="form-group">
                    <label>@Localizer["StartDate"]</label>
                    <input type="date" @bind="scheduleStartDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label>@Localizer["EndDate"]</label>
                    <input type="date" @bind="scheduleEndDate" class="form-control" />
                </div>

                <div class="form-group" hidden>
                    <label>Days of Week: *</label>
                    <div class="days-checkboxes">
                        <label><input type="checkbox" @bind="monday" /> Monday</label>
                        <label><input type="checkbox" @bind="tuesday" /> Tuesday</label>
                        <label><input type="checkbox" @bind="wednesday" /> Wednesday</label>
                        <label><input type="checkbox" @bind="thursday" /> Thursday</label>
                        <label><input type="checkbox" @bind="friday" /> Friday</label>
                        <label><input type="checkbox" @bind="saturday" /> Saturday</label>
                        <label><input type="checkbox" @bind="sunday" /> Sunday</label>
                    </div>
                </div>

            </div>

            <div class="form-section">
                <h3>@Localizer["TargetTeamsSection"]</h3>

                @if (currentTeam is not null)
                {
                    <div class="current-team-section">
                        <label class="section-label">@Localizer["CurrentTeamLabel"]</label>
                        <div class="team-checkbox current">
                            <label>
                                <input type="checkbox"
                                       checked="@selectedTeams.Contains(currentTeam.TeamID)"
                                       @onchange="@(e => ToggleTeam(currentTeam.TeamID, (bool)e.Value!))" />
                                <strong>@currentTeam.Name</strong> @Localizer["CurrentTeamSuffix"]
                            </label>
                            <small>@currentTeam.Description</small>
                        </div>
                    </div>
                }

                @if (availableTeams.Count == 0)
                {
                    <p class="no-teams">@Localizer["NoOtherTeams"]</p>
                }
                else
                {
                    var shown = ShownOtherTeams;

                    <label class="section-label">@Localizer["OtherTeamsLabel"]</label>

                    <div class="other-teams-toolbar">
                        <input type="text" class="other-teams-search" placeholder="@Localizer["SearchTeamsPlaceholder"]"
                               @bind="teamSearch" @bind:event="oninput" />
                        <label class="other-teams-toggle">
                            <input type="checkbox" @bind="showSelectedOnly" />
                            @Localizer["ShowSelectedOnly"]
                        </label>
                        <span class="other-teams-counter">
                            @string.Format(Localizer["SelectedCounter"].Value, OtherSelectedCount, availableTeams.Count)
                        </span>
                    </div>

                    @if (OtherSelectedCount > 0)
                    {
                        <div class="other-teams-chips">
                            @if (OtherSelectedCount == availableTeams.Count)
                            {
                                <span class="team-chip">
                                    @string.Format(Localizer["AllTeamsChip"].Value, availableTeams.Count)
                                    <button type="button" class="team-chip-remove" @onclick="ClearAllOtherTeams" aria-label="Clear">×</button>
                                </span>
                            }
                            else
                            {
                                var selectedOther = availableTeams
                                    .Where(t => selectedTeams.Contains(t.TeamID))
                                    .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
                                    .ToList();

                                @foreach (var team in selectedOther.Take(12))
                                {
                                    <span class="team-chip">
                                        @team.Name
                                        <button type="button" class="team-chip-remove"
                                                @onclick="@(() => ToggleTeam(team.TeamID, false))" aria-label="Remove">×</button>
                                    </span>
                                }
                                @if (selectedOther.Count > 12)
                                {
                                    <button type="button" class="team-chip team-chip-more" @onclick="@(() => showSelectedOnly = true)">
                                        @string.Format(Localizer["MoreChipsSuffix"].Value, selectedOther.Count - 12)
                                    </button>
                                }
                            }
                        </div>
                    }

                    <label class="other-teams-list-header">
                        <input type="checkbox" @ref="masterCheckboxRef"
                               checked="@MasterChecked(shown)"
                               @onchange="@(e => ToggleMaster(shown))" />
                        <span>
                            @(IsOtherTeamsFilterActive
                                ? string.Format(Localizer["SelectAllShownLabel"].Value, shown.Count)
                                : string.Format(Localizer["SelectAllLabel"].Value, availableTeams.Count))
                        </span>
                    </label>

                    @if (shown.Count == 0)
                    {
                        <p class="no-teams-match">
                            @(string.IsNullOrWhiteSpace(teamSearch)
                                ? Localizer["NoTeamsSelected"].Value
                                : string.Format(Localizer["NoTeamsMatch"].Value, teamSearch))
                        </p>
                    }
                    else
                    {
                        <div class="other-teams-scroll">
                            @foreach (var team in shown)
                            {
                                var isSelected = selectedTeams.Contains(team.TeamID);

                                <label class="other-team-row @(isSelected ? "selected" : "")">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="@(e => ToggleTeam(team.TeamID, (bool)e.Value!))" />
                                    <span class="other-team-name">@team.Name</span>
                                    <span class="other-team-folder">@team.FolderName</span>
                                    <span class="other-team-desc" title="@team.Description">@team.Description</span>
                                </label>
                            }
                        </div>
                    }
                }
            </div>

            <div class="form-section">
                <h3>@Localizer["OptionsSection"]</h3>

                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="requiresApproval" disabled />
                        @Localizer["RequireApproval"]
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <div class="success-content">
                        <strong>✓</strong> @successMessage
                    </div>
                    <button @onclick="ReturnToPresentations" class="btn btn-return">
                        @Localizer["BackToPresentations"]
                    </button>
                </div>
            }

            @if (string.IsNullOrEmpty(successMessage))
            {
                <div class="form-actions">
                    <button @onclick="Cancel" class="btn btn-secondary">@Localizer["Cancel"]</button>
                    <button @onclick="CreateAssignments" class="btn btn-primary" disabled="@(isCreating || selectedTeams.Count == 0)">
                        @(isCreating ? Localizer["Creating"].Value : CreateButtonLabel)
                    </button>
                </div>
            }
        </div>
    }
</div>

