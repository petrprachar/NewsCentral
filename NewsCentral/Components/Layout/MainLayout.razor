@inherits LayoutComponentBase
@using NewsCentral.Services
@using NewsCentral.Models
@using NewsCentral.Configuration
@using NewsCentral.Components.Shared
@inject AuthenticationService AuthService
@inject TeamContextService TeamContext
@inject TeamService TeamService
@inject EnvironmentSettingsService EnvironmentSettingsService
@inject EnvironmentContext EnvironmentContext
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* M4a — environment picker. Visible whether or not the user is logged in. *@
            <EnvironmentPicker />

            @* Display-only identity — reflects the Home team selector, updates on change *@
            @if (currentUser != null)
            {
                <span class="me-3 env-identity-chip" title="@currentUser.DisplayName">
                    <i class="bi bi-person-circle me-1"></i><span class="env-user-name">@currentUser.DisplayName</span>
                    @if (currentUser.IsSystemAdmin)
                    {
                        <span class="badge bg-primary ms-1 env-admin-badge">System Admin</span>
                    }
                </span>
                @if (!string.IsNullOrEmpty(currentTeamName))
                {
                    <span class="text-muted env-team-name">
                        <i class="bi bi-diagram-3 me-1"></i>@currentTeamName
                    </span>
                }
                <button class="btn btn-sm btn-outline-secondary ms-3" @onclick="SignOut"
                        title="Sign out" aria-label="Sign out">
                    <i class="bi bi-box-arrow-right me-1"></i><span class="env-signout-text">Sign out</span>
                </button>
            }
        </div>

        @* M3a — environment settings visibility banners. TODO(i18n): plain English for now. *@
        @if (currentUser != null)
        {
            @if (environmentBanner == EnvironmentBannerKind.MachineDefaults && currentUser.IsSystemAdmin)
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center mx-4 mt-2 mb-0">
                    <span>
                        This environment has no stored settings — using this machine's defaults (@bannerTargetText).@bannerPolicySuffix
                        @if (!string.IsNullOrEmpty(saveBannerError))
                        {
                            <strong class="text-danger ms-2">@saveBannerError.</strong>
                        }
                    </span>
                    <button class="btn btn-sm btn-outline-primary ms-3" @onclick="SaveCurrentDefaults" disabled="@isSavingEnvironmentDefaults">
                        @(isSavingEnvironmentDefaults ? "Saving..." : "Save to environment")
                    </button>
                </div>
            }
            else if (environmentBanner == EnvironmentBannerKind.Invalid)
            {
                <div class="alert alert-warning mx-4 mt-2 mb-0">
                    Distribution settings for this environment are invalid: @environmentError.
                    Publishing to clients is unavailable until an administrator fixes config/environment.json.
                </div>
            }
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private User? currentUser;
    private string? currentTeamName;
    private Dictionary<string, string> teamNamesByFolder = new(StringComparer.OrdinalIgnoreCase);

    private enum EnvironmentBannerKind { None, MachineDefaults, Invalid }
    private EnvironmentBannerKind environmentBanner = EnvironmentBannerKind.None;
    private string? bannerTargetText;
    private string? bannerPolicySuffix;
    private string? environmentError;
    private string? saveBannerError;
    private bool isSavingEnvironmentDefaults;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthenticationStateChanged += HandleAuthChanged;
        TeamContext.OnTeamChanged += HandleTeamChanged;
        EnvironmentSettingsService.SettingsChanged += HandleEnvironmentSettingsChanged;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        currentUser = AuthService.GetCurrentUser();

        if (currentUser != null && teamNamesByFolder.Count == 0)
        {
            try
            {
                var teams = await TeamService.GetAllTeamsAsync();
                teamNamesByFolder = teams.ToDictionary(
                    t => t.FolderName, t => t.Name, StringComparer.OrdinalIgnoreCase);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Top bar: failed to load team names: {ex.Message}");
            }
        }

        UpdateTeamName();

        // Environment banners are loaded on login (here) and on SettingsChanged (below) — no
        // polling, no FileSystemWatcher.
        if (currentUser != null)
            await RefreshEnvironmentBannerAsync();
        else
            environmentBanner = EnvironmentBannerKind.None;
    }

    private async Task RefreshEnvironmentBannerAsync()
    {
        var effective = await EnvironmentSettingsService.GetAsync();

        switch (effective.Source)
        {
            case EnvironmentSettingsSource.MachineDefaults:
                environmentBanner = EnvironmentBannerKind.MachineDefaults;
                bannerTargetText = ComposeBannerTarget(effective.Settings!.Distribution);
                bannerPolicySuffix = effective.PolicyEnvironmentName != null
                    ? $" (managed by policy: {effective.PolicyEnvironmentName})"
                    : null;
                environmentError = null;
                break;

            case EnvironmentSettingsSource.Invalid:
                environmentBanner = EnvironmentBannerKind.Invalid;
                // Trim any pre-existing trailing "." — the markup supplies exactly one itself, so
                // messages end with exactly one period regardless of how the raw error was formatted.
                environmentError = effective.Error?.TrimEnd('.');
                break;

            default: // EnvironmentFile — fully configured; nothing to show.
                environmentBanner = EnvironmentBannerKind.None;
                environmentError = null;
                break;
        }
    }

    // "Local: C:\...", "AzureBlob: account/container", or just "distribution disabled".
    private string ComposeBannerTarget(DistributionSettings distribution)
    {
        var target = EnvironmentSettingsService.DescribeDistributionTarget(distribution, EnvironmentContext.DataPath);
        return distribution.Enabled ? $"{distribution.Mode}: {target}" : target;
    }

    private async Task SaveCurrentDefaults()
    {
        saveBannerError = null;
        isSavingEnvironmentDefaults = true;
        try
        {
            // On success this raises SettingsChanged, which HandleEnvironmentSettingsChanged
            // picks up to refresh the banner (it will disappear, since Source becomes
            // EnvironmentFile) and re-render.
            await EnvironmentSettingsService.SaveCurrentDefaultsAsync();
        }
        catch (Exception ex)
        {
            saveBannerError = ex.Message.TrimEnd('.');
        }
        finally
        {
            isSavingEnvironmentDefaults = false;
        }
    }

    private async void HandleEnvironmentSettingsChanged()
    {
        await RefreshEnvironmentBannerAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Resolve the friendly team name from the current folder; fall back to the folder name.
    private void UpdateTeamName()
    {
        var folder = TeamContext.CurrentTeamFolderName;
        currentTeamName = !string.IsNullOrEmpty(folder) && teamNamesByFolder.TryGetValue(folder, out var name)
            ? name
            : folder;
    }

    private async void HandleAuthChanged()
    {
        // Reload the folder→name map on (re)login so the top bar populates.
        teamNamesByFolder = new(StringComparer.OrdinalIgnoreCase);
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleTeamChanged()
    {
        currentUser = AuthService.GetCurrentUser();
        UpdateTeamName();
        InvokeAsync(StateHasChanged);
    }

    // Clears the session; the login page then waits at /login for an explicit Login or
    // UPN Login click — nothing logs the user back in automatically.
    private void SignOut()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationStateChanged -= HandleAuthChanged;
        TeamContext.OnTeamChanged -= HandleTeamChanged;
        EnvironmentSettingsService.SettingsChanged -= HandleEnvironmentSettingsChanged;
    }
}
