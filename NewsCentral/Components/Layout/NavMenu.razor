@using NewsCentral.Services
@using Microsoft.Extensions.Localization
@inject AuthenticationService AuthService
@inject TeamContextService TeamContext
@inject IStringLocalizer<NavMenu> Localizer
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">NewsCentral</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-2" aria-hidden="true"></span> @Localizer["Home"]
            </NavLink>
        </div>

        @if (currentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="presentations">
                    <span class="bi bi-image me-2" aria-hidden="true"></span> @Localizer["Presentations"]
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="assignments">
                    <span class="bi bi-send me-2" aria-hidden="true"></span> @Localizer["Assignments"]
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="approvals">
                    <span class="bi bi-check-circle me-2" aria-hidden="true"></span> @Localizer["Approvals"]
                </NavLink>
            </div>

            @* SystemAdmin Section *@
            @if (currentUser.IsSystemAdmin)
            {
                <hr class="nav-divider" />
                
                <div class="nav-section-header px-3">
                    <small class="text-muted">@Localizer["AdminSection"]</small>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="teams">
                        <span class="bi bi-diagram-3 me-2" aria-hidden="true"></span> @Localizer["Teams"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <span class="bi bi-people me-2" aria-hidden="true"></span> @Localizer["Users"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="index-management">
                        <span class="bi bi-database me-2" aria-hidden="true"></span> @Localizer["IndexManagement"]
                    </NavLink>
                </div>
            }

            @if (!string.IsNullOrEmpty(currentTeamId) && AuthService.HasRole(currentTeamId, "TeamAdmin"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="key-management">
                        <span class="bi bi-key me-2" aria-hidden="true"></span> @Localizer["KeyManagement"]
                    </NavLink>
                </div>
            }

            <hr class="nav-divider" />

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings">
                    <span class="bi bi-gear me-2" aria-hidden="true"></span> @Localizer["Settings"]
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private NewsCentral.Models.User? currentUser;
    private string? currentTeamId;

    protected override void OnInitialized()
    {
        currentUser   = AuthService.GetCurrentUser();
        currentTeamId = TeamContext.GetCurrentTeamId();
        AuthService.OnAuthenticationStateChanged += HandleAuthenticationStateChanged;
        TeamContext.OnTeamChanged                += HandleTeamChanged;
    }

    private void HandleAuthenticationStateChanged()
    {
        currentUser = AuthService.GetCurrentUser();
        InvokeAsync(StateHasChanged);
    }

    private void HandleTeamChanged()
    {
        currentTeamId = TeamContext.GetCurrentTeamId();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationStateChanged -= HandleAuthenticationStateChanged;
        TeamContext.OnTeamChanged                -= HandleTeamChanged;
    }
}